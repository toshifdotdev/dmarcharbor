{
  "name": "@dmarcharbor/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --maxWorkers=1 --config vitest.integration.config.ts",
    "lint": "eslint src tests"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@better-auth/prisma-adapter": "^1.7.6",
    "@node-saml/node-saml": "^5.1.0",
    "@paddle/paddle-node-sdk": "^3.10.0",
    "@prisma/client": "6.12.0",
    "@types/pdfkit": "^0.17.6",
    "better-auth": "^1.7.6",
    "cors": "^2.8.5",
    "dotenv": "^18.0.3",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "fast-xml-parser": "5.11.1",
    "imapflow": "^2.1.1",
    "mailparser": "3.9.28",
    "openid-client": "^6.8.8",
    "pdfkit": "^0.20.2",
    "razorpay": "^2.9.8",
    "resend": "6.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/mailparser": "3.4.6",
    "@types/node": "^22.15.21",
    "@types/supertest": "^6.0.3",
    "prisma": "6.12.0",
    "supertest": "^7.1.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^5.0.1"
  }
}
