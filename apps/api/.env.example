DATABASE_URL=postgresql://dmarcharbor:dmarcharbor@localhost:5432/dmarcharbor
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:5173
PORT=4000
EMAIL_PROVIDER=console
EMAIL_FROM=DMARC Harbor <no-reply@dmarcharbor.com>
RESEND_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
REPORT_INGEST_SECRET=replace-with-a-random-machine-signing-secret
FORENSIC_PSEUDONYM_SECRET=replace-with-a-different-random-secret-for-pseudonymizing-forensic-data
FORENSIC_PII_ENCRYPTION_KEY=replace-with-a-different-random-key-for-encrypting-named-forensic-data
FORENSIC_RETENTION_DAYS=30
FORENSIC_PII_RETENTION_DAYS=7
ALERT_EVALUATION_INTERVAL_MINUTES=15
ALERT_ROLLUP_HOURS=24
ALERT_STALE_DAYS=7
REPORT_RETENTION_DAYS=400
REPORT_AGGREGATE_ADDRESS=dmarc-reports@reports.dmarcharbor.com
REPORT_FORENSIC_ADDRESS=dmarc-forensics@reports.dmarcharbor.com
# Optional: a separate mailbox for TLS-RPT reports. When unset, the aggregate
# address above is used. Subaddressing applies to it the same way.
# REPORT_TLSRPT_ADDRESS=tls-reports@reports.dmarcharbor.com
# Per-client report addresses: off, or plus.
#
# plus builds each client's address as <local>+<token>@<domain> from
# REPORT_AGGREGATE_ADDRESS. Routing is unchanged: an incoming report is still
# filed by the policy domain inside it, not by the address it was sent to. The
# token only identifies the client in DNS, and lets a published DMARC record
# prove domain ownership.
#
# Before turning this on, configure the inbound MTA to deliver
# local+anything@domain to the same mailbox or relay. For Postfix that is
# `recipient_delimiter = +`. Without it every report sent to a client address
# bounces, and the domain looks like it stopped reporting.
#
# Receivers enforce external report authorization (RFC 7489 section 7.1,
# RFC 9990). The report domain must publish a wildcard authorisation record:
#   *._report._dmarc.reports.dmarcharbor.com. TXT "v=DMARC1"
REPORT_ADDRESS_SUBADDRESSING=off
ALERT_SCHEDULER_DISABLED=false

# Continuous DNS monitoring. Every VERIFIED domain is rescanned on the
# interval, recording DMARC, SPF, DKIM and MX changes. The tick is how often
# the scheduler looks for work; the batch and concurrency bound one pass.
# DNS_MONITOR_ENABLED=false turns scheduled rescans off without disabling the
# other schedulers.
DNS_MONITOR_ENABLED=true
DNS_MONITOR_INTERVAL_MINUTES=1440
DNS_MONITOR_TICK_MINUTES=10
DNS_MONITOR_BATCH_SIZE=30
DNS_MONITOR_CONCURRENCY=3
# Domain-expiry alerts read each verified domain's registration expiry over
# RDAP (the IANA bootstrap list says which registry to ask) about once a day,
# and warn owners and admins at 30, 14, 7 and 1 days, and on expiry.
DOMAIN_EXPIRY_ENABLED=true
DOMAIN_EXPIRY_BATCH_SIZE=100

# Sender intelligence resolves reverse DNS and Team Cymru ASN data for public
# sending IPs in the background. This is the most IPs one pass may look up;
# five lookups run at a time. Private and reserved addresses are never queried.
SENDER_INTEL_BATCH=300

# Number of reverse proxies in front of this process, so rate limiters key on the
# real client address instead of the load balancer's. Set this to the real hop
# count in production: at 0 every IP-keyed limit shares one bucket across all
# tenants, and at a wrong non-zero value a client can forge X-Forwarded-For and
# walk straight past every limit. The service warns on boot when this is 0 in
# production.
TRUST_PROXY_HOPS=0

# Sign-in attempts allowed per client address per minute. There is no MFA, so
# this is the primary control on credential stuffing rather than a secondary one.
AUTH_RATE_LIMIT_PER_MINUTE=20

# Authenticated requests allowed per API key per minute.
API_RATE_LIMIT_PER_MINUTE=300

# Hosted DMARC records. All three must be set or none: a zone without a token
# serves nothing, and a token without a zone has nowhere to write. The zone must
# be a whole registered domain on Cloudflare; subdomain zones need an Enterprise
# plan. Cloudflare Free allows 200 DNS records in a zone; Pro and Business allow
# 3,500. HOSTED_DNS_RECORD_LIMIT is the number of hosted rows this deployment
# will create before refusing new hosting.
HOSTED_DNS_ZONE=
HOSTED_DNS_CLOUDFLARE_TOKEN=
HOSTED_DNS_CLOUDFLARE_ZONE_ID=
HOSTED_DNS_RECORD_LIMIT=200

# Where hosted BIMI logos and certificates are served from.
#
# An origin, not a URL: scheme, host and optional port, with no path, query or
# fragment. Leave it empty to switch hosted BIMI off; the panel then says it is
# not set up on this deployment, exactly as hosted DMARC does without a zone.
#
# Use a host of its own, not APP_URL. In production it must be https and must
# not share an origin with APP_URL, because the web app rewrites headers on
# every path and an SVG must not be served from the origin that holds the
# session cookie. Example: https://bimi.dmarcharbor.com
HOSTED_BIMI_ORIGIN=

# Hosted MTA-STS (RFC 8461), served through Cloudflare for SaaS.
#
# The hostname every customer's mta-sts.<domain> CNAME points at. It must be a
# hostname inside HOSTED_DNS_ZONE. Leave it empty to switch hosted MTA-STS off;
# the panel then says it is not set up on this deployment.
#
# Operator setup, done once by hand:
#   1. enable Cloudflare for SaaS on the hosted zone,
#   2. create a PROXIED fallback origin record that reaches the API (not the web
#      app — the policy is served by the API at the host root),
#   3. create the PROXIED CNAME named below, pointing at that fallback origin.
# The existing HOSTED_DNS_CLOUDFLARE_TOKEN must also allow
# Zone → SSL and Certificates → Edit on this zone, on top of DNS Edit.
#
# Example: mta.harbordns.net
HOSTED_MTA_STS_CNAME_TARGET=

# How many Cloudflare for SaaS custom hostnames this deployment will hold.
# Cloudflare includes 100 and charges $0.10 per hostname per month after that,
# so the default stops a deployment paying by accident. Hard ceiling: 50,000.
HOSTED_MTA_STS_HOSTNAME_LIMIT=100

# PSA ticketing.
#
# ConnectWise PSA requires a clientId header on every API call. It is issued to
# the vendor of the integration, free, from developer.connectwise.com, and it is
# deployment-wide rather than per customer. Leave it empty and the ConnectWise
# option is simply not offered; HaloPSA and Autotask need nothing here.
PSA_CONNECTWISE_CLIENT_ID=

# How often the PSA outbox is drained, in seconds.
PSA_DELIVERY_INTERVAL_SECONDS=60
# Turns the PSA drain off without disabling every other scheduler.
PSA_SCHEDULER_DISABLED=false
