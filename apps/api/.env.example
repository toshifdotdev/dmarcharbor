DATABASE_URL=postgresql://dmarcharbor:dmarcharbor@localhost:5432/dmarcharbor
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:5173
PORT=4000
EMAIL_PROVIDER=console
EMAIL_FROM=DMARC Harbor <no-reply@dmarcharbor.com>
RESEND_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
REPORT_INGEST_SECRET=replace-with-a-random-machine-signing-secret
FORENSIC_PSEUDONYM_SECRET=replace-with-a-different-random-secret-for-pseudonymizing-forensic-data
FORENSIC_PII_ENCRYPTION_KEY=replace-with-a-different-random-key-for-encrypting-named-forensic-data
FORENSIC_RETENTION_DAYS=30
FORENSIC_PII_RETENTION_DAYS=7
ALERT_EVALUATION_INTERVAL_MINUTES=15
ALERT_ROLLUP_HOURS=24
ALERT_STALE_DAYS=7
REPORT_RETENTION_DAYS=400
REPORT_AGGREGATE_ADDRESS=dmarc-reports@reports.dmarcharbor.com
REPORT_FORENSIC_ADDRESS=dmarc-forensics@reports.dmarcharbor.com
ALERT_SCHEDULER_DISABLED=false

# Number of reverse proxies in front of this process, so rate limiters key on the
# real client address instead of the load balancer's. Set this to the real hop
# count in production: at 0 every IP-keyed limit shares one bucket across all
# tenants, and at a wrong non-zero value a client can forge X-Forwarded-For and
# walk straight past every limit. The service warns on boot when this is 0 in
# production.
TRUST_PROXY_HOPS=0

# Sign-in attempts allowed per client address per minute. There is no MFA, so
# this is the primary control on credential stuffing rather than a secondary one.
AUTH_RATE_LIMIT_PER_MINUTE=20

# Authenticated requests allowed per API key per minute.
API_RATE_LIMIT_PER_MINUTE=300
