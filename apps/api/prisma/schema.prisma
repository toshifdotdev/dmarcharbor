datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                      String                  @id
  name                    String
  email                   String
  emailVerified           Boolean                 @default(false)
  image                   String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  sessions                Session[]
  accounts                Account[]
  twoFactor               TwoFactor?
  members                 Member[]
  invitations             Invitation[]
  requestedScans          Scan[]                  @relation("RequestedScans")
  enabledForensicPii      Domain[]                @relation("ForensicPiiEnabledBy")
  createdAlertRules       AlertRule[]             @relation("CreatedAlertRules")
  createdReportShares     ReportShare[]           @relation("CreatedReportShares")
  createdReportDigests    ReportDigest[]          @relation("CreatedReportDigests")
  notifications           Notification[]
  auditEvents             AuditLog[]
  portalAccessGrants      ClientPortalAccess[]
  alertDeliveries         AlertDelivery[]
  acknowledgedAlertEvents AlertEvent[]            @relation("AcknowledgedAlertEvents")
  createdDomainSwitches   DomainSwitch[]          @relation("CreatedDomainSwitches")
  acknowledgedDnsChanges  DnsChange[]             @relation("AcknowledgedDnsChanges")
  ownedSenderReviews      SenderReview[]          @relation("SenderReviewOwner")
  reviewedSenderReviews   SenderReview[]          @relation("SenderReviewer")
  createdDnsConnections   DnsProviderConnection[] @relation("CreatedDnsConnections")
  dnsPublications         DnsPublication[]        @relation("DnsPublications")
    notificationPreference  NotificationPreference?
    /// The account's subscription. Keyed here as well as on the workspace it was
    /// started from, so entitlement status can be read where the plan lives.
    subscriptions          Subscription[]
    /**
     * The plan this account holds, which every workspace it owns inherits.
     *
     * The plan used to live on Organization, so a person with three workspaces
     * had three subscriptions and three renewals, and a customer who bought
     * Admiralty had to buy it again to make a second workspace. Moving it here
     * makes one purchase cover the account: a plan is a thing a person buys, and
     * a workspace is a container they organise their clients into.
     *
     * The quota it grants is shared across the account's workspaces rather than
     * per workspace, which is what stops a plan from being farmed by splitting
     * the same clients across more containers.
     */
    plan                   PlanTier               @default(MOORING)
    /// The plan that will apply when the paid period ends, so a change is visible
    /// before it takes effect rather than discovered by losing a feature.
    pendingPlan            PlanTier?
    /// Which currency the account is quoted and billed in. INR goes to Razorpay
    /// and USD to Paddle, so this is the choice of payment processor rather than
    /// a display preference. Locked once a paid subscription exists.
    preferredCurrency      BillingCurrency        @default(INR)
    /// Better Auth's two-factor plugin owns this flag. It is true only after the
    /// authenticator code has been confirmed, never when setup merely started.
    twoFactorEnabled       Boolean                @default(false)

    @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?
  /// 'sso' when the session was minted by our own single sign-on callback.
  /// null means Better Auth created it (password, social or two-factor).
  authMethod           String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// Better Auth's two-factor storage. The model name must stay TwoFactor: the
/// plugin looks up the Prisma model `twoFactor`.
model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String    @unique
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@map("two_factor")
}

model Organization {
  id                    String                @id
  name                  String
  slug                  String
  logo                  String?
  createdAt             DateTime
  metadata              String?
  plan                  PlanTier              @default(MOORING)
  /// Which currency this workspace should be quoted and billed in.
  ///
  /// INR goes to Razorpay and USD to Paddle, so this is effectively the choice of
  /// payment processor rather than a display preference. It can change freely
  /// until a paid subscription exists, because that is the point at which moving
  /// means migrating a live subscription between two processors - which is a
  /// customer-facing risk, not a settings change.
  ///
  /// Defaults to INR because Razorpay is the processor we can actually take money
  /// with today, and a customer who reaches a checkout that returns 503 has
  /// already been lost. Flip this to USD the day Paddle is live; it is a default.
  preferredCurrency     BillingCurrency       @default(INR)
  /// When this workspace accepted the Data Processing Agreement, and which
  /// version of it they accepted.
  ///
  /// Recorded per organisation rather than per user, because an agency accepts the
  /// DPA on behalf of its clients. A member who leaves must not erase the record
  /// that the acceptance happened.
  ///
  /// The version matters more than the timestamp. A customer auditor's first
  /// question is which document was agreed to, and an acceptance with no version
  /// cannot answer it.
    dpaAcceptedAt         DateTime?
    /// Terms of Service acceptance, recorded on the workspace the way the DPA is.
    ///
    /// It lived only in a browser checkbox on the billing page, which meant it was
    /// never stored and never checked server side: a caller that ignored the UI
    /// could start a paid subscription without it, and a customer on the free plan
    /// never saw the document the service is provided under. Moving it here puts it
    /// where the DPA already is, which is the only place an acceptance can be proven.
    tosAcceptedAt          DateTime?
    tosVersion             String?
    tosAcceptedByEmail     String?
    tosAcceptedById        String?
    /// When true, a signed-in member who has neither two-step verification nor an
    /// SSO session is refused on this workspace's API.
    requireMfa             Boolean               @default(false)
    requireMfaChangedAt    DateTime?
    requireMfaChangedById  String?
  dpaVersion            String?
  /// The user who ticked the boxes, retained because "who signed" is asked and
  /// "yes, someone did" is not an answer.
  dpaAcceptedById       String?
  dpaAcceptedByEmail    String?
  brandLogoUrl          String?
  brandPrimaryColor     String?
  brandAccentColor      String?
  customDomain          String?               @unique
  customDomainToken     String?
  customDomainVerifiedAt DateTime?
  members               Member[]
  invitations           Invitation[]
  portalAccessGrants    ClientPortalAccess[]
  compliancePacks       CompliancePack[]
  clients               Client[]
  alertRules            AlertRule[]
  alertEvents           AlertEvent[]
  reportShares          ReportShare[]
  reportDigests         ReportDigest[]
  notifications         Notification[]
  AuditLog              AuditLog[]
  subscription          Subscription?
  entitlementOverrides  EntitlementOverride[]
  erasureRequests       ErasureRequest[]
  refunds               RefundRecord[]
  exportJobs            ExportJob[]
  apiKeys               ApiKey[]
  idempotencyRecords    IdempotencyRecord[]
  billingEvents         BillingEvent[]
  reportInbox           ReportInbox?
  slackDestination      SlackDestination?
  ssoConnections        SsoConnection[]
  webhookEndpoints      WebhookEndpoint[]
  domainSwitches        DomainSwitch[]
  dnsChanges            DnsChange[]
  monthlyReportSchedules MonthlyReportSchedule[]
  senderReviews         SenderReview[]
  dnsConnections        DnsProviderConnection[]
  dnsPublications       DnsPublication[]
  hostedDmarcRecords    HostedDmarcRecord[]
  hostedSpfRecords      HostedSpfRecord[]
  hostedBimiRecords     HostedBimiRecord[]
  hostedMtaStsRecords   HostedMtaStsRecord[]

  @@unique([slug])
  /// Reads the document version rather than the column being null, so the sweep
  /// for workspaces on an outdated version is an index lookup rather than a
  /// table scan over every tenant.
  ///
  /// Created by migration `20261002210000_dpa_acceptance` but missing here until
  /// now, which made it drift: `prisma migrate diff` reported it as removable and
  /// the next `prisma migrate dev` would have dropped the index a compliance
  /// sweep depends on.
  @@index([dpaVersion])
  @@index([plan])
  @@index([customDomain])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime
  /**
   * One membership per person per workspace.
   *
   * Without it, two concurrent SSO callbacks could both read "no member row",
   * both create one, and leave the workspace with a duplicate. That is not
   * cosmetic: the `member` quota counts these rows, so a duplicate inflates a
   * count the customer is sold, and it grants the same person two memberships to
   * audit against.
   */
  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model Client {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  domains        Domain[]
  reportShares   ReportShare[]
  portalAccess   ClientPortalAccess[]
  /**
   * Identifies this client in its report address: `local+<token>@domain`.
   *
   * Not a secret. It is published in DNS in the client's DMARC record, which is
   * exactly what lets that record prove the domain belongs to this client. What
   * matters is uniqueness, so a record carrying another client's token never
   * verifies this one.
   *
   * The database default is volatile, so existing rows get distinct values in
   * one statement rather than the same one.
   */
  reportToken    String        @unique @default(dbgenerated("substr(md5(((random())::text || (clock_timestamp())::text)), 1, 12)"))

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([trustSlug])
  @@map("client")
  /// Unguessable identifier for this client's public Trust Center.
  ///
  /// The Trust Center states what the platform holds and who can see it, which
  /// an enterprise auditor opens directly from a link. A guessable path would
  /// let anyone enumerate clients, so the slug is random and can be rotated
  /// without changing the underlying record.
  trustSlug              String?       @unique
  compliancePacks       CompliancePack[]
  monthlyReportSchedule MonthlyReportSchedule?
}

model Domain {
  id                     String                @id @default(cuid())
  /// Stable, human-readable identifier for this domain, used in URLs.
  ///
  /// The cuid was ending up in the address bar, in links customers paste into
  /// Slack, and in support emails, where it reads as an error even when nothing
  /// is wrong. A slug makes the URL name the thing it is about. Unique across
  /// the whole table rather than per client, so /domains/<slug> resolves without
  /// the client in the path.
  slug                   String                @unique
  clientId               String
  client                 Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /**
   * Globally unique, and this is load bearing.
   *
   * It was unique only per client, which meant two tenants could both add
   * `victim.com` and both reach VERIFIED. Report routing then found two rows for
   * the same name and returned `ambiguous_domain`, so *neither* tenant received
   * another report for that domain, ever, with nothing on either dashboard. One
   * tenant being able to add a name another tenant monitors was enough to
   * silently blind them.
   *
   * A domain belongs to exactly one agency in this product. A collision is refused
   * at the point of entry with an explanation, rather than being allowed to
   * accumulate into an ingestion outage nobody can see.
   */
  name                   String                @unique
  status                 DomainStatus          @default(PENDING)
  verificationToken      String                @unique @default(uuid())
  verifiedAt             DateTime?
  /// When this domain was last picked for a DNS re-check.
  ///
  /// The re-check decides whether a domain is still verified and sends the
  /// customer an email when that changes. Several instances doing the same row
  /// would each resolve DNS, each decide the transition happened, and each send
  /// the same email.
  recheckedAt            DateTime?
  /// When the scheduled DNS monitor last claimed this domain.
  ///
  /// Separate from `recheckedAt` (ownership re-verification) and `lastScanAt`
  /// (which manual scans also write), because the monitor's claim is the only
  /// one that must expire on its own interval.
  monitorClaimedAt       DateTime?
  lastScanAt             DateTime?
  dmarcPolicy            String?
  dmarcRecord            String?
  collectForensicReports Boolean               @default(false)
  retainForensicPii      Boolean               @default(false)
  forensicPiiEnabledAt   DateTime?
  forensicPiiEnabledById String?
  forensicPiiEnabledBy   User?                 @relation("ForensicPiiEnabledBy", fields: [forensicPiiEnabledById], references: [id], onDelete: SetNull)
  spfRecord              String?
  dkimSelectors          Json?
  mxRecords              Json?
  score                  Int?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  scans                  Scan[]
  dmarcReports           DmarcReport[]
  forensicReports        DmarcForensicReport[]
  alertRules             AlertRule[]
  alertEvents            AlertEvent[]
  reportShares           ReportShare[]
  auditEvents            AuditLog[]
  reportDigests          ReportDigest[]
  switch                 DomainSwitch?
  dnsChanges             DnsChange[]
  senderReviews          SenderReview[]
  dnsPublications        DnsPublication[]
  hostedDmarc            HostedDmarcRecord?
  hostedSpf              HostedSpfRecord?
  hostedBimi             HostedBimiRecord?
  hostedMtaSts           HostedMtaStsRecord?
  tlsReports             TlsReport[]

  /// The per client constraint is gone. Global uniqueness on `name` above
  /// subsumes it: two rows in one client with the same name would violate the
  /// global one anyway, so keeping both meant two indexes to keep in step.
  @@index([clientId])
  @@index([status])
  @@map("domain")
}

model Scan {
  id            String        @id @default(cuid())
  domainId      String
  domain        Domain        @relation(fields: [domainId], references: [id], onDelete: Cascade)
  requestedById String?
  requestedBy   User?         @relation("RequestedScans", fields: [requestedById], references: [id], onDelete: SetNull)
  status        ScanRunStatus @default(RUNNING)
  /// MANUAL when a person asked, SCHEDULED when the monitor did.
  trigger       ScanTrigger   @default(MANUAL)
  score         Int?
  result        Json?
  error         String?
  startedAt     DateTime      @default(now())
  completedAt   DateTime?
  updatedAt     DateTime      @updatedAt
  dnsChanges    DnsChange[]

  @@index([domainId, startedAt])
  @@index([domainId, trigger, startedAt])
  @@index([requestedById])
  @@index([status])
  @@map("scan")
}

model DmarcReport {
  id                    String              @id @default(cuid())
  domainId              String
  domain                Domain              @relation(fields: [domainId], references: [id], onDelete: Cascade)
  reportType            DmarcReportType
  /// SHA-256 of the raw XML. Identifies the exact bytes received.
  fingerprint           String              @unique
  /// SHA-256 of the report's own identity: reporting organisation, report id
  /// and date range. Two copies of one report can arrive by different
  /// transports with different bytes, and this is what catches that. Nullable
  /// and unique, so historical rows without one keep working.
  reportIdentity        String?             @unique
  reportId              String?
  reportingOrganization String?
  reportingEmail        String?
  extraContactInfo      String?
  dateRangeBegin        DateTime?
  dateRangeEnd          DateTime?
  policyDomain          String?
  policyAdkim           String?
  policyAspf            String?
  policyP               String?
  policySp              String?
  policyFraction        Int?
  reportError           String?
  recordCount           Int                 @default(0)
  receivedAt            DateTime            @default(now())
  retentionExpiresAt    DateTime?
  records               DmarcReportRecord[]

  @@index([domainId, receivedAt])
  @@index([domainId, dateRangeBegin])
  @@index([reportType, receivedAt])
  @@index([retentionExpiresAt])
  @@map("dmarc_report")
}

model DmarcReportRecord {
  id           String            @id @default(cuid())
  reportId     String
  report       DmarcReport       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  sourceIp     String
  messageCount Int
  disposition  String?
  dkimResult   String?
  spfResult    String?
  headerFrom   String?
  envelopeFrom String?
  senderDomain String?
  senderKey    String?
  policyReason String?
  authResults  DmarcAuthResult[]

  @@index([reportId])
  @@index([sourceIp])
  @@index([senderKey])
  @@map("dmarc_report_record")
}

model DmarcAuthResult {
  id       String            @id @default(cuid())
  recordId String
  record   DmarcReportRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  type     DmarcAuthType
  domain   String?
  selector String?
  scope    String?
  result   String

  @@index([recordId])
  @@map("dmarc_auth_result")
}

model DmarcForensicReport {
  id                         String    @id @default(cuid())
  domainId                   String
  domain                     Domain    @relation(fields: [domainId], references: [id], onDelete: Cascade)
  fingerprint                String    @unique
  feedbackType               String
  reportedDomain             String
  sourceIp                   String
  sourcePort                 Int?
  disposition                String?
  deliveryAction             String?
  deliveryStatus             String?
  dkimResult                 String?
  spfResult                  String?
  authResults                Json?
  reportingMta               String?
  dsnGateway                 String?
  remoteMta                  String?
  userAgent                  String?
  diagnosticCodes            Json?
  recipientCount             Int       @default(0)
  recipientPseudonyms        Json?
  envelopeFromPseudonym      String?
  messageIdPseudonym         String?
  subjectPseudonym           String?
  originalMessageDate        DateTime?
  arrivedAt                  DateTime?
  hasOriginalHeaders         Boolean   @default(false)
  hasOriginalMessageIncluded Boolean   @default(false)
  piiRetained                Boolean   @default(false)
  recipientAddresses         Json?
  subjectLine                String?
  envelopeFrom               String?
  redactionVersion           Int
  retentionExpiresAt         DateTime
  receivedAt                 DateTime  @default(now())

  @@index([domainId, receivedAt])
  @@index([retentionExpiresAt])
  @@index([reportedDomain])
  @@index([sourceIp])
  @@map("dmarc_forensic_report")
}

model DomainSwitch {
  id                        String              @id @default(cuid())
  domainId                  String              @unique
  domain                    Domain              @relation(fields: [domainId], references: [id], onDelete: Cascade)
  organizationId            String
  organization              Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status                    DomainSwitchStatus  @default(PLANNED)
  /// A vendor id from the switch-kit list, or `self` / `other`.
  incumbentVendor           String
  incumbentLabel            String
  /// The raw rua URIs classified as the incumbent's.
  incumbentAggregateTargets Json
  /// The raw ruf URIs that point at the same incumbent hosts.
  incumbentForensicTargets  Json
  /// The record as read at planning time.
  originalRecord            String
  /// The dual record generated at planning time.
  plannedRecord             String
  lastSeenRecord            String?
  externalAuthorization     String?
  /// Issue codes from §6.4, as string[].
  issues                    Json                @default("[]")
  startedAt                 DateTime?
  cutOverAt                 DateTime?
  lastCheckedAt             DateTime?
  createdById               String?
  createdBy                 User?               @relation("CreatedDomainSwitches", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  @@index([organizationId, status])
  @@map("domain_switch")
}

enum DomainSwitchStatus {
  PLANNED
  DUAL_REPORTING
  CUT_OVER
}

enum DomainStatus {
  PENDING
  VERIFIED
  FAILED
}

enum ScanRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum ScanTrigger {
  MANUAL
  SCHEDULED
}

enum DnsChangeKind {
  DMARC_RECORD
  DMARC_POLICY
  DMARC_RUA
  SPF_RECORD
  SPF_LOOKUPS
  SPF_ALL
  DKIM_SELECTOR
  MX
  MTA_STS
  TLS_RPT
  BIMI
}

enum DnsChangeSeverity {
  INFO
  WARNING
  CRITICAL
}

/// One meaningful difference between two completed scans of the same domain.
model DnsChange {
  id                String           @id @default(cuid())
  organizationId    String
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  domainId          String
  domain            Domain           @relation(fields: [domainId], references: [id], onDelete: Cascade)
  scanId            String
  scan              Scan             @relation(fields: [scanId], references: [id], onDelete: Cascade)
  /// The earlier scan compared against. Not a foreign key, so pruning an old
  /// scan never removes the change that proves something happened.
  previousScanId    String?
  kind              DnsChangeKind
  severity          DnsChangeSeverity
  /// Stable machine code, e.g. dmarc_policy_weakened.
  code              String
  /// One plain sentence for the person reading the history.
  summary           String
  before            Json?
  after             Json?
  detectedAt        DateTime         @default(now())
  notifiedAt        DateTime?
  acknowledgedAt    DateTime?
  acknowledgedById  String?
  acknowledgedBy    User?            @relation("AcknowledgedDnsChanges", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  notifications     Notification[]

  @@index([domainId, detectedAt])
  @@index([organizationId, detectedAt])
  @@index([notifiedAt, severity])
  @@map("dns_change")
}

enum DmarcReportType {
  AGGREGATE
  FORENSIC
}

enum DmarcAuthType {
  DKIM
  SPF
}

model AlertRule {
  id               String           @id @default(cuid())
  organizationId   String
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  domainId         String
  domain           Domain           @relation(fields: [domainId], references: [id], onDelete: Cascade)
  createdById      String?
  createdBy        User?            @relation("CreatedAlertRules", fields: [createdById], references: [id], onDelete: SetNull)
  name             String
  metric           AlertMetric
  operator         AlertOperator
  threshold        Int
  windowMinutes    Int              @default(1440)
  cooldownMinutes  Int              @default(1440)
  maxReminderLevel Int              @default(3)
  enabled          Boolean          @default(true)
  lastTriggeredAt  DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  recipients       AlertRecipient[]
  events           AlertEvent[]

  @@index([organizationId, enabled])
  @@index([domainId, enabled])
  @@index([enabled, lastTriggeredAt])
  @@map("alert_rule")
}

model AlertRecipient {
  id        String    @id @default(cuid())
  ruleId    String
  rule      AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime  @default(now())

  @@unique([ruleId, userId])
  @@index([ruleId])
  @@map("alert_recipient")
}

model AlertEvent {
  id                  String          @id @default(cuid())
  ruleId              String
  rule                AlertRule       @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  organizationId      String
  organization        Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  domainId            String
  domain              Domain          @relation(fields: [domainId], references: [id], onDelete: Cascade)
  metric              AlertMetric
  operator            AlertOperator
  observedValue       Int
  threshold           Int
  windowMinutes       Int
  summary             String
  context             Json?
  reminderLevel       Int             @default(1)
  acknowledgedAt      DateTime?
  acknowledgedById    String?
  acknowledgedBy      User?           @relation("AcknowledgedAlertEvents", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  lastOwnerNotifiedAt DateTime?
  ownerRollupLevel    Int             @default(0)
  staleAt             DateTime?
  resolvedAt          DateTime?
  triggeredAt         DateTime        @default(now())
  deliveries          AlertDelivery[]
  notifications       Notification[]

  @@index([ruleId, triggeredAt])
  @@index([ruleId, acknowledgedAt])
  @@index([staleAt])
  @@index([domainId, triggeredAt])
  @@index([organizationId, triggeredAt])
  @@map("alert_event")
}

model AlertDelivery {
  id            String              @id @default(cuid())
  eventId       String
  event         AlertEvent          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel       AlertChannel        @default(EMAIL)
  kind          AlertDeliveryKind   @default(ALERT)
  status        AlertDeliveryStatus @default(PENDING)
  reminderLevel Int                 @default(1)
