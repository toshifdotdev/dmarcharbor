model Subscription {
  id                     String             @id @default(cuid())
  organizationId         String
  organization           Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// The account this subscription bills.
  ///
  /// Added alongside organizationId rather than replacing it, because the two
  /// answer different questions. A provider webhook arrives carrying the provider's
  /// own subscription id and is matched to the workspace that started the
  /// checkout, so organizationId is how the row is found. The account is who the
  /// plan belongs to and where entitlement status is read from. Replacing one with
  /// the other would break provider matching or lose the account.
  userId                 String?
  user                   User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                   PlanTier           @default(MOORING)
  /// What the provider bills now. Always 1 for a flat plan; for a per-domain
  /// plan it is the domain count measured before the current period started.
  quantity               Int                @default(1)
  /// The period end whose quantity has already been pushed to the provider.
  ///
  /// Null until the first sync. Comparing it with `currentPeriodEnd` is what
  /// stops the same change being sent twice inside one 48 hour window.
  quantitySyncedPeriodEnd DateTime?
  status                 SubscriptionStatus @default(ACTIVE)
  provider               BillingProvider    @default(NONE)
  providerCustomerId     String?
  providerSubscriptionId String?            @unique
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  /// How far through payment recovery this subscription is.
  ///
  /// Without it a withdrawn subscription kept matching the PAST_DUE filter,
  /// because withdrawing left the status alone and never advanced the period, so
  /// the customer was warned and emailed again on every daily run, for ever.
  dunningStage           DunningStage       @default(NONE)
  /// The plan that will apply when the paid period ends.
  ///
  /// A plan change is not immediate, so without somewhere to record the request
  /// the workspace's own plan and the provider's subscription disagree and nobody
  /// can see it. The customer used to find out by losing a feature, which is the
  /// worst way to be told.
  pendingPlan            PlanTier?
  pendingPlanInterval    BillingInterval?
  /// When a failed payment stops being forgiven and the workspace is withdrawn.
  /// Null when no payment is failing. Exposed so the grace period can be stated
  /// as a duration instead of leaving the customer to guess how long they have.
  graceEndsAt            DateTime?
  /// When the most recent provider event we accepted for this subscription occurred.
  ///
  /// Both providers redeliver out of order, and there is no ordering on the
  /// subscription itself, so a late `subscription.activated` would otherwise
  /// resurrect a subscription the customer had already cancelled. Without a
  /// timestamp to compare against there is no way to tell a fresh event from a
  /// stale one, and `occurredAt` on the incoming event is the only other signal.
  lastEventAt            DateTime?
  /// When this workspace's first payment settled.
  ///
  /// The refund policy promises a 30 day money back guarantee on every purchase, and
  /// nothing recorded when a purchase happened. `BillingEvent.occurredAt` is the
  /// closest thing to the truth but it is the event's own timestamp and an event is
  /// retained, deduplicated and eventually purged, so an eligibility check that
  /// depended on it would start answering differently as the table emptied.
  ///
  /// Derived from the earliest charge at the point a subscription becomes paid, and
  /// null until then. Null means "no completed purchase on record", which is the
  /// honest answer rather than "not eligible, no reason given".
  firstChargeAt          DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@unique([organizationId])
  @@index([provider])
  @@index([status])
  @@map("subscription")
}

/// A refund we issued, or refused to.
///
/// Recorded rather than inferred from the provider, because the published promise
/// is a 30 day money back guarantee on every purchase and support needs to answer
/// "is this one still inside the window" without opening a provider dashboard and
/// guessing. The provider's own refund state is the authority on whether the money
/// moved; this row is the authority on what we promised and what we did.
model RefundRecord {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// The provider's own identifier for the refund, when one came back.
  providerRefundId String?
  provider       BillingProvider
  /// Minor units, integer arithmetic throughout, as everywhere else in billing.
  amountMinor     Int
  currency       String
  plan           PlanTier
  /// The purchase this refund is against, as it stood when asked about.
  firstChargeAt  DateTime?
  eligible       Boolean
  /// Why it was refused. Null on a refund that went through.
  refusalReason  String?
  /// The day 30 after the first charge, which is what "within the guarantee" means.
  eligibleUntil  DateTime?
  reason         String
  actorUserId    String?
  createdAt      DateTime      @default(now())

  @@index([organizationId])
  @@index([createdAt])
  @@map("refund_record")
}

