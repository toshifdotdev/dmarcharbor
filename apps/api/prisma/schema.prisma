datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                      String                  @id
  name                    String
  email                   String
  emailVerified           Boolean                 @default(false)
  image                   String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  sessions                Session[]
  accounts                Account[]
  members                 Member[]
  invitations             Invitation[]
  requestedScans          Scan[]                  @relation("RequestedScans")
  enabledForensicPii      Domain[]                @relation("ForensicPiiEnabledBy")
  createdAlertRules       AlertRule[]             @relation("CreatedAlertRules")
  createdReportShares     ReportShare[]           @relation("CreatedReportShares")
  createdReportDigests    ReportDigest[]          @relation("CreatedReportDigests")
  notifications           Notification[]
  auditEvents             AuditLog[]
  portalAccessGrants      ClientPortalAccess[]
  alertDeliveries         AlertDelivery[]
  acknowledgedAlertEvents AlertEvent[]            @relation("AcknowledgedAlertEvents")
  notificationPreference  NotificationPreference?

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id                    String                @id
  name                  String
  slug                  String
  logo                  String?
  createdAt             DateTime
  metadata              String?
  plan                  PlanTier              @default(MOORING)
  brandLogoUrl          String?
  brandPrimaryColor     String?
  brandAccentColor      String?
  customDomain          String?               @unique
  customDomainToken     String?
  customDomainVerifiedAt DateTime?
  members               Member[]
  invitations           Invitation[]
  portalAccessGrants    ClientPortalAccess[]
  clients               Client[]
  alertRules            AlertRule[]
  alertEvents           AlertEvent[]
  reportShares          ReportShare[]
  reportDigests         ReportDigest[]
  notifications         Notification[]
  AuditLog              AuditLog[]
  subscription          Subscription?
  entitlementOverrides  EntitlementOverride[]
  erasureRequests       ErasureRequest[]
  exportJobs            ExportJob[]
  apiKeys               ApiKey[]
  idempotencyRecords    IdempotencyRecord[]
  billingEvents         BillingEvent[]
  webhookEndpoints      WebhookEndpoint[]

  @@unique([slug])
  @@index([plan])
  @@index([customDomain])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model Client {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  domains        Domain[]
  reportShares   ReportShare[]
  portalAccess   ClientPortalAccess[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("client")
}

model Domain {
  id                     String                @id @default(cuid())
  clientId               String
  client                 Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name                   String
  status                 DomainStatus          @default(PENDING)
  verificationToken      String                @unique @default(uuid())
  verifiedAt             DateTime?
  lastScanAt             DateTime?
  dmarcPolicy            String?
  dmarcRecord            String?
  collectForensicReports Boolean               @default(false)
  retainForensicPii      Boolean               @default(false)
  forensicPiiEnabledAt   DateTime?
  forensicPiiEnabledById String?
  forensicPiiEnabledBy   User?                 @relation("ForensicPiiEnabledBy", fields: [forensicPiiEnabledById], references: [id], onDelete: SetNull)
  spfRecord              String?
  dkimSelectors          Json?
  mxRecords              Json?
  score                  Int?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  scans                  Scan[]
  dmarcReports           DmarcReport[]
  forensicReports        DmarcForensicReport[]
  alertRules             AlertRule[]
  alertEvents            AlertEvent[]
  reportShares           ReportShare[]
  auditEvents            AuditLog[]
  reportDigests          ReportDigest[]

  @@unique([clientId, name])
  @@index([clientId])
  @@index([status])
  @@map("domain")
}

model Scan {
  id            String        @id @default(cuid())
  domainId      String
  domain        Domain        @relation(fields: [domainId], references: [id], onDelete: Cascade)
  requestedById String?
  requestedBy   User?         @relation("RequestedScans", fields: [requestedById], references: [id], onDelete: SetNull)
  status        ScanRunStatus @default(RUNNING)
  score         Int?
  result        Json?
  error         String?
  startedAt     DateTime      @default(now())
  completedAt   DateTime?
  updatedAt     DateTime      @updatedAt

  @@index([domainId, startedAt])
  @@index([requestedById])
  @@index([status])
  @@map("scan")
}

model DmarcReport {
  id                    String              @id @default(cuid())
  domainId              String
  domain                Domain              @relation(fields: [domainId], references: [id], onDelete: Cascade)
  reportType            DmarcReportType
  fingerprint           String              @unique
  reportId              String?
  reportingOrganization String?
  reportingEmail        String?
  extraContactInfo      String?
  dateRangeBegin        DateTime?
  dateRangeEnd          DateTime?
  policyDomain          String?
  policyAdkim           String?
  policyAspf            String?
  policyP               String?
  policySp              String?
  policyFraction        Int?
  reportError           String?
  recordCount           Int                 @default(0)
  receivedAt            DateTime            @default(now())
  retentionExpiresAt    DateTime?
  records               DmarcReportRecord[]

  @@index([domainId, receivedAt])
  @@index([reportType, receivedAt])
  @@index([retentionExpiresAt])
  @@map("dmarc_report")
}

model DmarcReportRecord {
  id           String            @id @default(cuid())
  reportId     String
  report       DmarcReport       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  sourceIp     String
  messageCount Int
  disposition  String?
  dkimResult   String?
  spfResult    String?
  headerFrom   String?
  envelopeFrom String?
  senderDomain String?
  senderKey    String?
  policyReason String?
  authResults  DmarcAuthResult[]

  @@index([reportId])
  @@index([sourceIp])
  @@index([senderKey])
  @@map("dmarc_report_record")
}

model DmarcAuthResult {
  id       String            @id @default(cuid())
  recordId String
  record   DmarcReportRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  type     DmarcAuthType
  domain   String?
  selector String?
  scope    String?
  result   String

  @@index([recordId])
  @@map("dmarc_auth_result")
}

model DmarcForensicReport {
  id                         String    @id @default(cuid())
  domainId                   String
  domain                     Domain    @relation(fields: [domainId], references: [id], onDelete: Cascade)
  fingerprint                String    @unique
  feedbackType               String
  reportedDomain             String
  sourceIp                   String
  sourcePort                 Int?
  disposition                String?
  deliveryAction             String?
  deliveryStatus             String?
  dkimResult                 String?
  spfResult                  String?
  authResults                Json?
  reportingMta               String?
  dsnGateway                 String?
  remoteMta                  String?
  userAgent                  String?
  diagnosticCodes            Json?
  recipientCount             Int       @default(0)
  recipientPseudonyms        Json?
  envelopeFromPseudonym      String?
  messageIdPseudonym         String?
  subjectPseudonym           String?
  originalMessageDate        DateTime?
  arrivedAt                  DateTime?
  hasOriginalHeaders         Boolean   @default(false)
  hasOriginalMessageIncluded Boolean   @default(false)
  piiRetained                Boolean   @default(false)
  recipientAddresses         Json?
  subjectLine                String?
  envelopeFrom               String?
  redactionVersion           Int
  retentionExpiresAt         DateTime
  receivedAt                 DateTime  @default(now())

  @@index([domainId, receivedAt])
  @@index([retentionExpiresAt])
  @@index([reportedDomain])
  @@index([sourceIp])
  @@map("dmarc_forensic_report")
}

enum DomainStatus {
  PENDING
  VERIFIED
  FAILED
}

enum ScanRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum DmarcReportType {
  AGGREGATE
  FORENSIC
}

enum DmarcAuthType {
  DKIM
  SPF
}

model AlertRule {
  id               String           @id @default(cuid())
  organizationId   String
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  domainId         String
  domain           Domain           @relation(fields: [domainId], references: [id], onDelete: Cascade)
  createdById      String?
  createdBy        User?            @relation("CreatedAlertRules", fields: [createdById], references: [id], onDelete: SetNull)
  name             String
  metric           AlertMetric
  operator         AlertOperator
  threshold        Int
  windowMinutes    Int              @default(1440)
  cooldownMinutes  Int              @default(1440)
  maxReminderLevel Int              @default(3)
  enabled          Boolean          @default(true)
  lastTriggeredAt  DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  recipients       AlertRecipient[]
  events           AlertEvent[]

  @@index([organizationId, enabled])
  @@index([domainId, enabled])
  @@index([enabled, lastTriggeredAt])
  @@map("alert_rule")
}

model AlertRecipient {
  id        String    @id @default(cuid())
  ruleId    String
  rule      AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime  @default(now())

  @@unique([ruleId, userId])
  @@index([ruleId])
  @@map("alert_recipient")
}

model AlertEvent {
  id                  String          @id @default(cuid())
  ruleId              String
  rule                AlertRule       @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  organizationId      String
  organization        Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  domainId            String
  domain              Domain          @relation(fields: [domainId], references: [id], onDelete: Cascade)
  metric              AlertMetric
  operator            AlertOperator
  observedValue       Int
  threshold           Int
  windowMinutes       Int
  summary             String
  context             Json?
  reminderLevel       Int             @default(1)
  acknowledgedAt      DateTime?
  acknowledgedById    String?
  acknowledgedBy      User?           @relation("AcknowledgedAlertEvents", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  lastOwnerNotifiedAt DateTime?
  ownerRollupLevel    Int             @default(0)
  staleAt             DateTime?
  resolvedAt          DateTime?
  triggeredAt         DateTime        @default(now())
  deliveries          AlertDelivery[]
  notifications       Notification[]

  @@index([ruleId, triggeredAt])
  @@index([ruleId, acknowledgedAt])
  @@index([staleAt])
  @@index([domainId, triggeredAt])
  @@index([organizationId, triggeredAt])
  @@map("alert_event")
}

model AlertDelivery {
  id            String              @id @default(cuid())
  eventId       String
  event         AlertEvent          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel       AlertChannel        @default(EMAIL)
  kind          AlertDeliveryKind   @default(ALERT)
  status        AlertDeliveryStatus @default(PENDING)
  reminderLevel Int                 @default(1)
  attempts      Int                 @default(0)
  lastError     String?
  sentAt        DateTime?
  createdAt     DateTime            @default(now())

  @@unique([eventId, userId, channel, kind, reminderLevel])
  @@index([userId, status])
  @@map("alert_delivery")
}

model ReportShare {
  id               String       @id @default(cuid())
  token            String       @unique
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId         String
  client           Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  domainId         String
  domain           Domain       @relation(fields: [domainId], references: [id], onDelete: Cascade)
  createdById      String?
  createdBy        User?        @relation("CreatedReportShares", fields: [createdById], references: [id], onDelete: SetNull)
  includeForensics Boolean      @default(false)
  includeSources   Boolean      @default(true)
  expiresAt        DateTime
  revokedAt        DateTime?
  lastViewedAt     DateTime?
  viewCount        Int          @default(0)
  createdAt        DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([domainId])
  @@map("report_share")
}

model Notification {
  id             String               @id @default(cuid())
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind           NotificationKind     @default(ALERT)
  severity       NotificationSeverity @default(WARNING)
  title          String
  body           String
  link           String?
  alertEventId   String?
  reminderLevel  Int                  @default(1)
  alertEvent     AlertEvent?          @relation(fields: [alertEventId], references: [id], onDelete: Cascade)
  readAt         DateTime?
  createdAt      DateTime             @default(now())

  @@unique([alertEventId, userId, reminderLevel])
  @@index([userId, readAt, createdAt])
  @@index([organizationId, createdAt])
  @@map("notification")
}

model ReportDigest {
  id               String          @id @default(cuid())
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  domainId         String
  domain           Domain          @relation(fields: [domainId], references: [id], onDelete: Cascade)
  createdById      String?
  createdBy        User?           @relation("CreatedReportDigests", fields: [createdById], references: [id], onDelete: SetNull)
  frequency        DigestFrequency @default(WEEKLY)
  sendHourUtc      Int             @default(9)
  weekday          Int             @default(1)
  dayOfMonth       Int             @default(1)
  recipientEmails  String[]
  includeForensics Boolean         @default(false)
  enabled          Boolean         @default(true)
  lastSentAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([enabled, lastSentAt])
  @@index([domainId])
  @@map("report_digest")
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  domainId       String?
  domain         Domain?       @relation(fields: [domainId], references: [id], onDelete: SetNull)
  actorUserId    String?
  actorUser      User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action         AuditAction
  targetType     String
  targetId       String?
  outcome        AuditOutcome  @default(SUCCESS)
  detail         Json?
  ipAddress      String?
  requestId      String?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([domainId, createdAt])
  @@index([action, createdAt])
  @@map("audit_log")
}

model NotificationPreference {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailAlerts        Boolean  @default(true)
  timezone           String   @default("UTC")
  quietHoursStart    String?
  quietHoursEnd      String?
  onlyHighRiskAlerts Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("notification_preference")
}

enum AlertMetric {
  FAILURE_COUNT
  FAILURE_RATE
  SOURCE_IP_VOLUME
  FORENSIC_FAILURES
  REPORT_SILENCE
  NEW_UNAUTHENTICATED_SOURCE
}

enum AlertOperator {
  GREATER_THAN
  GREATER_THAN_OR_EQUAL
  LESS_THAN
}

enum AlertChannel {
  EMAIL
}

enum AlertDeliveryKind {
  ALERT
  ROLLUP
}

enum NotificationKind {
  ALERT
  DIGEST
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

enum DigestFrequency {
  WEEKLY
  MONTHLY
}

model Subscription {
  id                     String             @id @default(cuid())
  organizationId         String
  organization           Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                   PlanTier           @default(MOORING)
  status                 SubscriptionStatus @default(ACTIVE)
  provider               BillingProvider    @default(NONE)
  providerCustomerId     String?
  providerSubscriptionId String?            @unique
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@unique([organizationId])
  @@index([provider])
  @@index([status])
  @@map("subscription")
}

model EntitlementOverride {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entitlement    String
  enabled        Boolean       @default(true)
  reason         String?
  expiresAt      DateTime?
  createdById    String?
  createdAt      DateTime      @default(now())

  @@unique([organizationId, entitlement])
  @@index([expiresAt])
  @@map("entitlement_override")
}

model ApiKey {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  prefix         String
  keyHash        String        @unique
  scopes         String[]      @default(["read"])
  lastUsedAt     DateTime?
  lastUsedIp     String?
  revokedAt      DateTime?
  expiresAt      DateTime?
  createdById    String?
  createdAt      DateTime      @default(now())

  @@index([organizationId, revokedAt])
  @@map("api_key")
}

model ClientPortalAccess {
  id             String        @id @default(cuid())
  clientId       String
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName    String?
  revokedAt      DateTime?
  firstSeenAt    DateTime?
  invitedById    String?
  createdAt      DateTime      @default(now())

  @@unique([clientId, email])
  @@index([email])
  @@index([userId])
  @@index([organizationId, revokedAt])
  @@map("client_portal_access")
}

model WebhookEndpoint {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  url            String
  secret         String
  events         String[]
  active         Boolean           @default(true)
  suspendedAt    DateTime?
  failureCount   Int               @default(0)
  lastDeliveryAt DateTime?
  createdById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deliveries     WebhookDelivery[]

  @@index([organizationId, active])
  @@map("webhook_endpoint")
}

model WebhookDelivery {
  id            String                @id @default(cuid())
  endpointId    String
  endpoint      WebhookEndpoint       @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  organizationId String
  event         String
  payload       Json
  status        WebhookDeliveryStatus @default(PENDING)
  attempts      Int                   @default(0)
  responseCode  Int?
  lastError     String?
  nextAttemptAt DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime              @default(now())

  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
  @@map("webhook_delivery")
}

/// A billing webhook that has been received, with the provider's own id
/// deduplicating redeliveries. Both providers retry until acknowledged, so the
/// same event can arrive many times and out of order.
model BillingEvent {
  id                     String        @id @default(cuid())
  providerEventId        String        @unique
  provider               BillingProvider
  type                   String
  organizationId         String?
  organization           Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  providerSubscriptionId String?
  payload                Json
  occurredAt             DateTime
  createdAt              DateTime      @default(now())

  @@index([organizationId])
  @@index([providerSubscriptionId])
  @@index([createdAt])
  @@map("billing_event")
}

model IdempotencyRecord {
  id             String       @id @default(cuid())
  key            String       @unique
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestHash    String
  statusCode     Int?
  responseBody   Json?
  createdAt      DateTime     @default(now())

  @@index([createdAt])
  @@index([organizationId])
  @@map("idempotency_record")
}

model ExportJob {
  id                 String        @id @default(cuid())
  organizationId     String
  organization       Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedById      String
  scope              ExportScope   @default(ORGANIZATION)
  targetId           String?
  scopeLabel         String
  format             ExportFormat  @default(JSON)
  state              ExportState   @default(READY)
  downloadTokenHash  String?       @unique
  downloadExpiresAt  DateTime?
  downloadedAt       DateTime?
  redactions         Json?
  purgeAfter         DateTime
  createdAt          DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([state, purgeAfter])
  @@map("export_job")
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  SUSPENDED
}

enum ExportScope {
  ORGANIZATION
  CLIENT
  DOMAIN
}

enum ExportFormat {
  JSON
  CSV
}

enum ExportState {
  READY
  REVOKED
  EXPIRED
}

model ErasureRequest {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  scope          ErasureScope  @default(ORGANIZATION)
  targetId       String?
  requestedById  String
  state          ErasureState  @default(PENDING)
  certificate    Json?
  purgeAfter     DateTime
  completedAt    DateTime?
  createdAt      DateTime      @default(now())

  @@index([organizationId, state])
  @@index([state, purgeAfter])
  @@index([completedAt])
  @@map("erasure_request")
}

enum PlanTier {
  MOORING
  FAIRWAY
  HARBOR
  ADMIRALTY
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum BillingProvider {
  NONE
  RAZORPAY
  PADDLE
}

enum ErasureScope {
  ORGANIZATION
  CLIENT
  DOMAIN
}

enum ErasureState {
  PENDING
  COMPLETED
  CANCELLED
}

enum AuditAction {
  FORENSIC_IDENTITY_ENABLED
  FORENSIC_IDENTITY_DISABLED
  FORENSIC_PURGE_SINGLE
  FORENSIC_PURGE_DOMAIN
  REPORT_SHARE_CREATED
  REPORT_SHARE_REVOKED
  REPORT_DIGEST_CREATED
  REPORT_DIGEST_UPDATED
  REPORT_DIGEST_DELETED
  ALERT_RULE_CREATED
  ALERT_RULE_UPDATED
  ALERT_RULE_DELETED
  ALERT_ACKNOWLEDGED
  SESSION_REVOKED
  SESSIONS_REVOKED_OTHERS
  SESSIONS_REVOKED_ALL
  PASSWORD_CHANGED
