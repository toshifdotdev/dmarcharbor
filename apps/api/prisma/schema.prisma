datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                      String                  @id
  name                    String
  email                   String
  emailVerified           Boolean                 @default(false)
  image                   String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  sessions                Session[]
  accounts                Account[]
  members                 Member[]
  invitations             Invitation[]
  requestedScans          Scan[]                  @relation("RequestedScans")
  enabledForensicPii      Domain[]                @relation("ForensicPiiEnabledBy")
  createdAlertRules       AlertRule[]             @relation("CreatedAlertRules")
  createdReportShares     ReportShare[]           @relation("CreatedReportShares")
  createdReportDigests    ReportDigest[]          @relation("CreatedReportDigests")
  notifications           Notification[]
  auditEvents             AuditLog[]
  portalAccessGrants      ClientPortalAccess[]
  alertDeliveries         AlertDelivery[]
  acknowledgedAlertEvents AlertEvent[]            @relation("AcknowledgedAlertEvents")
  notificationPreference  NotificationPreference?

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id                    String                @id
  name                  String
  slug                  String
  logo                  String?
  createdAt             DateTime
  metadata              String?
  plan                  PlanTier              @default(MOORING)
  /// Which currency this workspace should be quoted and billed in.
  ///
  /// INR goes to Razorpay and USD to Paddle, so this is effectively the choice of
  /// payment processor rather than a display preference. It can change freely
  /// until a paid subscription exists, because that is the point at which moving
  /// means migrating a live subscription between two processors - which is a
  /// customer-facing risk, not a settings change.
  ///
  /// Defaults to INR because Razorpay is the processor we can actually take money
  /// with today, and a customer who reaches a checkout that returns 503 has
  /// already been lost. Flip this to USD the day Paddle is live; it is a default.
  preferredCurrency     BillingCurrency       @default(INR)
  brandLogoUrl          String?
  brandPrimaryColor     String?
  brandAccentColor      String?
  customDomain          String?               @unique
  customDomainToken     String?
  customDomainVerifiedAt DateTime?
  members               Member[]
  invitations           Invitation[]
  portalAccessGrants    ClientPortalAccess[]
  compliancePacks       CompliancePack[]
  clients               Client[]
  alertRules            AlertRule[]
  alertEvents           AlertEvent[]
  reportShares          ReportShare[]
  reportDigests         ReportDigest[]
  notifications         Notification[]
  AuditLog              AuditLog[]
  subscription          Subscription?
  entitlementOverrides  EntitlementOverride[]
  erasureRequests       ErasureRequest[]
  exportJobs            ExportJob[]
  apiKeys               ApiKey[]
  idempotencyRecords    IdempotencyRecord[]
  billingEvents         BillingEvent[]
  reportInbox           ReportInbox?
  slackDestination      SlackDestination?
  ssoConnections        SsoConnection[]
  webhookEndpoints      WebhookEndpoint[]

  @@unique([slug])
  @@index([plan])
  @@index([customDomain])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model Client {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  domains        Domain[]
  reportShares   ReportShare[]
  portalAccess   ClientPortalAccess[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([trustSlug])
  @@map("client")
  /// Unguessable identifier for this client's public Trust Center.
  ///
  /// The Trust Center states what the platform holds and who can see it, which
  /// an enterprise auditor opens directly from a link. A guessable path would
  /// let anyone enumerate clients, so the slug is random and can be rotated
  /// without changing the underlying record.
  trustSlug              String?       @unique
  compliancePacks       CompliancePack[]
}

model Domain {
  id                     String                @id @default(cuid())
  /// Stable, human-readable identifier for this domain, used in URLs.
  ///
  /// The cuid was ending up in the address bar, in links customers paste into
  /// Slack, and in support emails, where it reads as an error even when nothing
  /// is wrong. A slug makes the URL name the thing it is about. Unique across
  /// the whole table rather than per client, so /domains/<slug> resolves without
  /// the client in the path.
  slug                   String                @unique
  clientId               String
  client                 Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name                   String
  status                 DomainStatus          @default(PENDING)
  verificationToken      String                @unique @default(uuid())
  verifiedAt             DateTime?
  /// When this domain was last picked for a DNS re-check.
  ///
  /// The re-check decides whether a domain is still verified and sends the
  /// customer an email when that changes. Several instances doing the same row
  /// would each resolve DNS, each decide the transition happened, and each send
  /// the same email.
  recheckedAt            DateTime?
  lastScanAt             DateTime?
  dmarcPolicy            String?
  dmarcRecord            String?
  collectForensicReports Boolean               @default(false)
  retainForensicPii      Boolean               @default(false)
  forensicPiiEnabledAt   DateTime?
  forensicPiiEnabledById String?
  forensicPiiEnabledBy   User?                 @relation("ForensicPiiEnabledBy", fields: [forensicPiiEnabledById], references: [id], onDelete: SetNull)
  spfRecord              String?
  dkimSelectors          Json?
  mxRecords              Json?
  score                  Int?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  scans                  Scan[]
  dmarcReports           DmarcReport[]
  forensicReports        DmarcForensicReport[]
  alertRules             AlertRule[]
  alertEvents            AlertEvent[]
  reportShares           ReportShare[]
  auditEvents            AuditLog[]
  reportDigests          ReportDigest[]

  @@unique([clientId, name])
  @@index([clientId])
  @@index([status])
  @@map("domain")
}

model Scan {
  id            String        @id @default(cuid())
  domainId      String
  domain        Domain        @relation(fields: [domainId], references: [id], onDelete: Cascade)
  requestedById String?
  requestedBy   User?         @relation("RequestedScans", fields: [requestedById], references: [id], onDelete: SetNull)
  status        ScanRunStatus @default(RUNNING)
  score         Int?
  result        Json?
  error         String?
  startedAt     DateTime      @default(now())
  completedAt   DateTime?
  updatedAt     DateTime      @updatedAt

  @@index([domainId, startedAt])
  @@index([requestedById])
  @@index([status])
  @@map("scan")
}

model DmarcReport {
  id                    String              @id @default(cuid())
  domainId              String
  domain                Domain              @relation(fields: [domainId], references: [id], onDelete: Cascade)
  reportType            DmarcReportType
  /// SHA-256 of the raw XML. Identifies the exact bytes received.
  fingerprint           String              @unique
  /// SHA-256 of the report's own identity: reporting organisation, report id
  /// and date range. Two copies of one report can arrive by different
  /// transports with different bytes, and this is what catches that. Nullable
  /// and unique, so historical rows without one keep working.
  reportIdentity        String?             @unique
  reportId              String?
  reportingOrganization String?
  reportingEmail        String?
  extraContactInfo      String?
  dateRangeBegin        DateTime?
  dateRangeEnd          DateTime?
  policyDomain          String?
  policyAdkim           String?
  policyAspf            String?
  policyP               String?
  policySp              String?
  policyFraction        Int?
  reportError           String?
  recordCount           Int                 @default(0)
  receivedAt            DateTime            @default(now())
  retentionExpiresAt    DateTime?
  records               DmarcReportRecord[]

  @@index([domainId, receivedAt])
  @@index([reportType, receivedAt])
  @@index([retentionExpiresAt])
  @@map("dmarc_report")
}

model DmarcReportRecord {
  id           String            @id @default(cuid())
  reportId     String
  report       DmarcReport       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  sourceIp     String
  messageCount Int
  disposition  String?
  dkimResult   String?
  spfResult    String?
  headerFrom   String?
  envelopeFrom String?
  senderDomain String?
  senderKey    String?
  policyReason String?
  authResults  DmarcAuthResult[]

  @@index([reportId])
  @@index([sourceIp])
  @@index([senderKey])
  @@map("dmarc_report_record")
}

model DmarcAuthResult {
  id       String            @id @default(cuid())
  recordId String
  record   DmarcReportRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  type     DmarcAuthType
  domain   String?
  selector String?
  scope    String?
  result   String

  @@index([recordId])
  @@map("dmarc_auth_result")
}

model DmarcForensicReport {
  id                         String    @id @default(cuid())
  domainId                   String
  domain                     Domain    @relation(fields: [domainId], references: [id], onDelete: Cascade)
  fingerprint                String    @unique
  feedbackType               String
  reportedDomain             String
  sourceIp                   String
  sourcePort                 Int?
  disposition                String?
  deliveryAction             String?
  deliveryStatus             String?
  dkimResult                 String?
  spfResult                  String?
  authResults                Json?
  reportingMta               String?
  dsnGateway                 String?
  remoteMta                  String?
  userAgent                  String?
  diagnosticCodes            Json?
  recipientCount             Int       @default(0)
  recipientPseudonyms        Json?
  envelopeFromPseudonym      String?
  messageIdPseudonym         String?
  subjectPseudonym           String?
  originalMessageDate        DateTime?
  arrivedAt                  DateTime?
  hasOriginalHeaders         Boolean   @default(false)
  hasOriginalMessageIncluded Boolean   @default(false)
  piiRetained                Boolean   @default(false)
  recipientAddresses         Json?
  subjectLine                String?
  envelopeFrom               String?
  redactionVersion           Int
  retentionExpiresAt         DateTime
  receivedAt                 DateTime  @default(now())

  @@index([domainId, receivedAt])
  @@index([retentionExpiresAt])
  @@index([reportedDomain])
  @@index([sourceIp])
  @@map("dmarc_forensic_report")
}

enum DomainStatus {
  PENDING
  VERIFIED
  FAILED
}

enum ScanRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum DmarcReportType {
  AGGREGATE
  FORENSIC
}

enum DmarcAuthType {
  DKIM
  SPF
}

model AlertRule {
  id               String           @id @default(cuid())
  organizationId   String
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  domainId         String
  domain           Domain           @relation(fields: [domainId], references: [id], onDelete: Cascade)
  createdById      String?
  createdBy        User?            @relation("CreatedAlertRules", fields: [createdById], references: [id], onDelete: SetNull)
  name             String
  metric           AlertMetric
  operator         AlertOperator
  threshold        Int
  windowMinutes    Int              @default(1440)
  cooldownMinutes  Int              @default(1440)
  maxReminderLevel Int              @default(3)
  enabled          Boolean          @default(true)
  lastTriggeredAt  DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  recipients       AlertRecipient[]
  events           AlertEvent[]

  @@index([organizationId, enabled])
  @@index([domainId, enabled])
  @@index([enabled, lastTriggeredAt])
  @@map("alert_rule")
}

model AlertRecipient {
  id        String    @id @default(cuid())
  ruleId    String
  rule      AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime  @default(now())

  @@unique([ruleId, userId])
  @@index([ruleId])
  @@map("alert_recipient")
}

model AlertEvent {
  id                  String          @id @default(cuid())
  ruleId              String
  rule                AlertRule       @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  organizationId      String
  organization        Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  domainId            String
  domain              Domain          @relation(fields: [domainId], references: [id], onDelete: Cascade)
  metric              AlertMetric
  operator            AlertOperator
  observedValue       Int
  threshold           Int
  windowMinutes       Int
  summary             String
  context             Json?
  reminderLevel       Int             @default(1)
  acknowledgedAt      DateTime?
  acknowledgedById    String?
  acknowledgedBy      User?           @relation("AcknowledgedAlertEvents", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  lastOwnerNotifiedAt DateTime?
  ownerRollupLevel    Int             @default(0)
  staleAt             DateTime?
  resolvedAt          DateTime?
  triggeredAt         DateTime        @default(now())
  deliveries          AlertDelivery[]
  notifications       Notification[]

  @@index([ruleId, triggeredAt])
  @@index([ruleId, acknowledgedAt])
  @@index([staleAt])
  @@index([domainId, triggeredAt])
  @@index([organizationId, triggeredAt])
  @@map("alert_event")
}

model AlertDelivery {
  id            String              @id @default(cuid())
  eventId       String
  event         AlertEvent          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel       AlertChannel        @default(EMAIL)
  kind          AlertDeliveryKind   @default(ALERT)
  status        AlertDeliveryStatus @default(PENDING)
  reminderLevel Int                 @default(1)
  attempts      Int                 @default(0)
  lastError     String?
  sentAt        DateTime?
  createdAt     DateTime            @default(now())

  @@unique([eventId, userId, channel, kind, reminderLevel])
  @@index([userId, status])
  @@map("alert_delivery")
}

model ReportShare {
  id               String       @id @default(cuid())
  token            String       @unique
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId         String
  client           Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  domainId         String
  domain           Domain       @relation(fields: [domainId], references: [id], onDelete: Cascade)
  createdById      String?
  createdBy        User?        @relation("CreatedReportShares", fields: [createdById], references: [id], onDelete: SetNull)
  includeForensics Boolean      @default(false)
  includeSources   Boolean      @default(true)
  expiresAt        DateTime
  revokedAt        DateTime?
  lastViewedAt     DateTime?
  viewCount        Int          @default(0)
  createdAt        DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([domainId])
  @@map("report_share")
}

model Notification {
  id             String               @id @default(cuid())
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind           NotificationKind     @default(ALERT)
  severity       NotificationSeverity @default(WARNING)
  title          String
  body           String
  link           String?
  alertEventId   String?
  reminderLevel  Int                  @default(1)
  alertEvent     AlertEvent?          @relation(fields: [alertEventId], references: [id], onDelete: Cascade)
  readAt         DateTime?
  createdAt      DateTime             @default(now())

  @@unique([alertEventId, userId, reminderLevel])
  @@index([userId, readAt, createdAt])
  @@index([organizationId, createdAt])
  @@map("notification")
}

model ReportDigest {
  id               String          @id @default(cuid())
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  domainId         String
  domain           Domain          @relation(fields: [domainId], references: [id], onDelete: Cascade)
  createdById      String?
  createdBy        User?           @relation("CreatedReportDigests", fields: [createdById], references: [id], onDelete: SetNull)
  frequency        DigestFrequency @default(WEEKLY)
  sendHourUtc      Int             @default(9)
  weekday          Int             @default(1)
  dayOfMonth       Int             @default(1)
  recipientEmails  String[]
  includeForensics Boolean         @default(false)
  enabled          Boolean         @default(true)
  lastSentAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([enabled, lastSentAt])
  @@index([domainId])
  @@map("report_digest")
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  domainId       String?
  domain         Domain?       @relation(fields: [domainId], references: [id], onDelete: SetNull)
  actorUserId    String?
  actorUser      User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action         AuditAction
  targetType     String
  targetId       String?
  outcome        AuditOutcome  @default(SUCCESS)
  detail         Json?
  ipAddress      String?
  requestId      String?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([domainId, createdAt])
  @@index([action, createdAt])
  @@map("audit_log")
}

model NotificationPreference {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailAlerts        Boolean  @default(true)
  timezone           String   @default("UTC")
  quietHoursStart    String?
  quietHoursEnd      String?
  onlyHighRiskAlerts Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("notification_preference")
}

enum AlertMetric {
  FAILURE_COUNT
  FAILURE_RATE
  SOURCE_IP_VOLUME
  FORENSIC_FAILURES
  REPORT_SILENCE
  NEW_UNAUTHENTICATED_SOURCE
}

enum AlertOperator {
  GREATER_THAN
  GREATER_THAN_OR_EQUAL
  LESS_THAN
}

enum AlertChannel {
  EMAIL
  SLACK
}

enum AlertDeliveryKind {
  ALERT
  ROLLUP
}

enum NotificationKind {
  ALERT
  DIGEST
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

enum DigestFrequency {
  WEEKLY
  MONTHLY
}

model Subscription {
  id                     String             @id @default(cuid())
  organizationId         String
  organization           Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                   PlanTier           @default(MOORING)
  status                 SubscriptionStatus @default(ACTIVE)
  provider               BillingProvider    @default(NONE)
  providerCustomerId     String?
  providerSubscriptionId String?            @unique
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  /// How far through payment recovery this subscription is.
  ///
  /// Without it a withdrawn subscription kept matching the PAST_DUE filter,
  /// because withdrawing left the status alone and never advanced the period, so
  /// the customer was warned and emailed again on every daily run, for ever.
  dunningStage           DunningStage       @default(NONE)
  /// The plan that will apply when the paid period ends.
  ///
  /// A plan change is not immediate, so without somewhere to record the request
  /// the workspace's own plan and the provider's subscription disagree and nobody
  /// can see it. The customer used to find out by losing a feature, which is the
  /// worst way to be told.
  pendingPlan            PlanTier?
  pendingPlanInterval    BillingInterval?
  /// When a failed payment stops being forgiven and the workspace is withdrawn.
  /// Null when no payment is failing. Exposed so the grace period can be stated
  /// as a duration instead of leaving the customer to guess how long they have.
  graceEndsAt            DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@unique([organizationId])
  @@index([provider])
  @@index([status])
  @@map("subscription")
}

model EntitlementOverride {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entitlement    String
  enabled        Boolean       @default(true)
  reason         String?
  expiresAt      DateTime?
  createdById    String?
  createdAt      DateTime      @default(now())

  @@unique([organizationId, entitlement])
  @@index([expiresAt])
  @@map("entitlement_override")
}

model ApiKey {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  prefix         String
  keyHash        String        @unique
  scopes         String[]      @default(["read"])
  lastUsedAt     DateTime?
  lastUsedIp     String?
  revokedAt      DateTime?
  expiresAt      DateTime?
  createdById    String?
  createdAt      DateTime      @default(now())

  @@index([organizationId, revokedAt])
  @@map("api_key")
}

model ClientPortalAccess {
  id             String        @id @default(cuid())
  clientId       String
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName    String?
  revokedAt      DateTime?
  firstSeenAt    DateTime?
  invitedById    String?
  createdAt      DateTime      @default(now())

  @@unique([clientId, email])
  @@index([email])
  @@index([userId])
  @@index([organizationId, revokedAt])
  @@map("client_portal_access")
}

model WebhookEndpoint {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  url            String
  secret         String
  events         String[]
  active         Boolean           @default(true)
  suspendedAt    DateTime?
  failureCount   Int               @default(0)
  lastDeliveryAt DateTime?
  createdById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deliveries     WebhookDelivery[]

  @@index([organizationId, active])
  @@map("webhook_endpoint")
}

model WebhookDelivery {
  id            String                @id @default(cuid())
  endpointId    String
  endpoint      WebhookEndpoint       @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  organizationId String
  event         String
  payload       Json
  status        WebhookDeliveryStatus @default(PENDING)
  attempts      Int                   @default(0)
  responseCode  Int?
  lastError     String?
  nextAttemptAt DateTime?
  deliveredAt   DateTime?
  /**
   * When the claim was taken, and by whom.
   *
   * A claim that outlives the lease means the instance holding it died mid
   * request, so the lease is what lets the delivery be retried by another
   * instance rather than stranded in IN_FLIGHT for good.
   */
  claimedAt     DateTime?
  claimedBy     String?
  createdAt     DateTime              @default(now())

  @@index([status, nextAttemptAt, createdAt])
  @@index([endpointId, createdAt])
  @@map("webhook_delivery")
}

/// A plan as it exists at a payment provider.
///
/// Our own tier and price live in the catalog, but the provider's plan id has
/// to be stored somewhere, because a plan created on the provider's dashboard
/// by hand is just as real as one created by code. Keeping it in the database
/// means the mapping survives a deploy and can be inspected during support.
model BillingPlan {
  id              String          @id @default(cuid())
  provider        BillingProvider
  tier            PlanTier
  /// Monthly or annual, as the provider spells it.
  interval        BillingInterval
  currency        BillingCurrency
  /// Smallest currency unit, matching the catalog.
  priceMinor      Int
  /// The provider's own identifier for this plan.
  providerPlanId  String
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([provider, tier, interval, currency])
  @@index([provider, active])
  @@map("billing_plan")
}

/// The mailbox that receives emailed DMARC reports.
///
/// One per workspace rather than per customer: the product works by pointing
/// every monitored domain's rua tag at our own address, so there is a single
/// shared inbox and no customer ever hands us credentials.
///
/// The password is account level access, so it is encrypted with the same key
/// as other sensitive values. The last seen UID lets each poll resume instead of
/// rescanning, which keeps the cost flat regardless of mailbox age.
enum SsoProtocol {
  SAML
  OIDC
}

enum SsoProvisioningMode {
  /// Create the member on first successful assertion, bounded by a domain allowlist.
  JIT
  /// Only people who already hold an invitation may sign in.
  DISABLED
}

/// One identity provider connection for one workspace.
///
/// Holds the provider's credentials, so it belongs to exactly one workspace and
/// is always read through a workspace scope. A connection id from another
/// workspace must resolve to nothing rather than to a usable IdP.
model SsoConnection {
  id                   String             @id @default(cuid())
  organizationId       String
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  label                String
  protocol             SsoProtocol
  issuer               String
  entryPoint           String
  /// The relying party identifier registered with the customer's provider.
  clientId             String
  idpCertificate       String?
  tokenEndpoint        String?
  userinfoEndpoint     String?
  /// Encrypted. The client secret is account level access to the identity
  /// provider, and is never returned by any endpoint.
  clientSecretEncrypted String
  provisioning         SsoProvisioningMode @default(JIT)
  defaultRole          String             @default("analyst")
  enabled              Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  /// The email domains permitted to provision. This allowlist is the security
  /// boundary for just in time provisioning, so it is a separate table rather
  /// than a delimited string that could be misparsed.
  connections          SsoConnectionDomain[]
  /// Authorisation requests in flight, so a callback behind a load balancer can
  /// be answered by an instance that did not issue it.
  authRequests         SsoAuthRequest[]

  @@index([organizationId])
  @@map("sso_connection")
}

/// A single sign on authorisation request that has not come back yet.
///
/// The state nonce is the whole point: it is single use, so an authorisation
/// response captured from a browser cannot be replayed into a second session.
/// Stored in the database rather than a signed cookie so the callback works on
/// any instance behind a load balancer.
/// A short lived claim on running one named job.
///
/// Every scheduler in this service starts on boot, so an autoscaled deployment
/// runs each of them once per instance. Node is single threaded, so a flag is
/// enough to stop one process overlapping itself, but it knows nothing about the
/// other processes: with three replicas a customer gets three copies of the same
/// digest email. This row is how the processes find out about each other.
///
/// Acquired with a single conditional upsert, so it is safe on a pooled
/// connection, and it expires on its own, so an instance killed mid job does not
/// need a reaper to release it.
model JobLease {
  name String @id
  /// The instance currently holding it, for tracing a stuck job to a process.
  holder String
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
  @@map("job_lease")
}

model SsoAuthRequest {
  id           String        @id @default(cuid())
  connectionId String
  connection   SsoConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  nonce        String        @unique
  /// The PKCE verifier for this request.
  ///
  /// Held server side rather than in the browser so that an intercepted
  /// authorisation code cannot be redeemed without it.
  verifier     String
  createdAt    DateTime      @default(now())

  @@map("sso_auth_request")
}

/// One permitted email domain on an SSO connection.
model SsoConnectionDomain {
  id           String        @id @default(cuid())
  connectionId String
  connection   SsoConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  /// Lowercased and without a leading @, so a comparison cannot be evaded by
  /// case or by writing it differently.
  domain       String

  @@unique([connectionId, domain])
  @@map("sso_connection_domain")
}

model ReportInbox {
  id                  String    @id @default(cuid())
  organizationId      String    @unique
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  host                String
  port                Int       @default(993)
  secure              Boolean   @default(true)
  username            String
  encryptedPassword   String
  lastPolledAt        DateTime?
  /// When this instance started polling, used to stop several instances opening
  /// a connection to the same customer mail host at once.
  pollClaimedAt       DateTime?
  lastUid             BigInt?
  enabled             Boolean   @default(true)
  consecutiveFailures Int       @default(0)
  lastError           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([enabled])
  @@map("report_inbox")
}

/// One Slack channel per workspace, not per user.
///
/// A Slack channel is shared by everybody in it, so an individual email
/// preference cannot sensibly gate it: turning off your own email must not
/// silence the channel your team reads, and switching your own email on must not
/// start posting there. The workspace decides once, via `enabled`.
///
/// The webhook URL is a credential, not a setting. Anyone holding it can post to
/// the channel, so it is encrypted at rest and never returned in full.
model SlackDestination {
  id                  String    @id @default(cuid())
  organizationId      String    @unique
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Channel name for display only, e.g. "dmarc-alerts". Slack resolves the
  /// destination from the webhook URL, so this is never used to route anything.
  channelLabel        String?
  encryptedWebhookUrl String
  enabled             Boolean   @default(true)
  /// Set while an instance is delivering, so a fleet does not post the same
  /// alert to the same channel several times at once.
  deliveryClaimedAt   DateTime?
  lastDeliveredAt     DateTime?
  consecutiveFailures Int       @default(0)
  lastError           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([enabled])
  @@map("slack_destination")
}

/// A signed compliance pack issued for one client.
///
/// The PDF is not stored. Its SHA-256 is, because the hash is the claim and the
/// bytes are not, and storing both would mean the document could be silently
/// replaced. History is kept so a pack an auditor already holds stays provable
/// after a later regeneration.
model CompliancePack {
  id             String    @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  scope          String
  documentVersion String
  /// The state of the world the document describes, and the PDF creation date.
  /// Fixed rather than taken from the clock, so the same inputs give the same
  /// bytes and therefore the same hash.
  asOf           DateTime
  pdfHash        String    @unique
  /// The value printed in the document and quoted when asking us for the digest.
  ///
  /// Previously the document printed a freshly minted UUID that was then
  /// discarded, while the public lookup resolved against the primary key. The
  /// number a reader was told to quote therefore could not be quoted, and a
  /// regenerated-but-identical document printed a different one for the same
  /// bytes.
  ///
  /// Human-readable on purpose. A customer reading this to their compliance team
  /// needs to say it out loud, and a cuid is neither quotable nor legible.
  reference      String    @unique
  byteSize       Int
  pageCount      Int
  supersededAt   DateTime?
  generatedById  String?
  createdAt      DateTime  @default(now())

  @@index([clientId])
  @@index([organizationId])
  @@index([createdAt])
  @@map("compliance_pack")
}

/// A billing webhook that has been received, with the provider's own id
/// deduplicating redeliveries. Both providers retry until acknowledged, so the
/// same event can arrive many times and out of order.
model BillingEvent {
  id                     String        @id @default(cuid())
  providerEventId        String        @unique
  provider               BillingProvider
  type                   String
  organizationId         String?
  organization           Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  providerSubscriptionId String?
  payload                Json
  occurredAt             DateTime
  createdAt              DateTime      @default(now())

  @@index([organizationId])
  @@index([providerSubscriptionId])
  @@index([createdAt])
  @@map("billing_event")
}

model IdempotencyRecord {
  id             String       @id @default(cuid())
  key            String       @unique
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestHash    String
  statusCode     Int?
  responseBody   Json?
  createdAt      DateTime     @default(now())

  @@index([createdAt])
  @@index([organizationId])
  @@map("idempotency_record")
}

model ExportJob {
  id                 String        @id @default(cuid())
  organizationId     String
  organization       Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedById      String
  scope              ExportScope   @default(ORGANIZATION)
  targetId           String?
  scopeLabel         String
  format             ExportFormat  @default(JSON)
  state              ExportState   @default(READY)
  downloadTokenHash  String?       @unique
  downloadExpiresAt  DateTime?
  downloadedAt       DateTime?
  redactions         Json?
  purgeAfter         DateTime
  createdAt          DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([state, purgeAfter])
  @@map("export_job")
}

enum WebhookDeliveryStatus {
  PENDING
  /// Claimed by one instance and not yet answered. Only the claimer sends it.
  IN_FLIGHT
  DELIVERED
  FAILED
  SUSPENDED
}

enum ExportScope {
  ORGANIZATION
  CLIENT
  DOMAIN
}

enum ExportFormat {
  JSON
  CSV
}

enum ExportState {
  READY
  REVOKED
  EXPIRED
}

model ErasureRequest {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  scope          ErasureScope  @default(ORGANIZATION)
  targetId       String?
  requestedById  String
  state          ErasureState  @default(PENDING)
  certificate    Json?
  purgeAfter     DateTime
  completedAt    DateTime?
  /// When the claim was taken, so a row stranded by a killed instance can be
  /// returned to PENDING instead of sitting in EXECUTING for ever.
  claimedAt      DateTime?
  createdAt      DateTime      @default(now())

  @@index([organizationId, state])
  @@index([state, purgeAfter])
  @@index([completedAt])
  @@map("erasure_request")
}

enum PlanTier {
  MOORING
  FAIRWAY
  HARBOR
  ADMIRALTY
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

/// Currencies a plan can be sold in. INR divides into paise and USD into cents,
/// and both are stored in those smallest units rather than as a decimal.
enum BillingCurrency {
  USD
  INR
}

/// How far through payment recovery a subscription has got.
///
/// Each step is recorded so it happens once rather than on every run.
enum DunningStage {
  NONE
  /// The customer has been told their payment failed and is inside the grace
  /// window. The warning is not repeated.
  WARNED
  /// Access has already been withdrawn. Terminal, so the row leaves the
  /// recovery query entirely.
  WITHDRAWN
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum BillingProvider {
  NONE
  RAZORPAY
  PADDLE
}

enum ErasureScope {
  ORGANIZATION
  CLIENT
  DOMAIN
}

enum ErasureState {
  PENDING
  /// Claimed by one instance and mid deletion.
  ///
  /// Without an intermediate state two instances both read PENDING, both delete,
  /// and both send the GDPR completion email. Worse, the loser throws on
  /// organization.delete after the winner has already destroyed the row, which
  /// surfaces as a scheduler error and hides the real outcome.
  EXECUTING
  COMPLETED
  CANCELLED
}

