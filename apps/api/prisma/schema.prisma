model ErasureRequest {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
    scope          ErasureScope  @default(ORGANIZATION)
    targetId       String?
    /// The reason the requester gave, kept on the row itself.
    ///
    /// It was accepted by the request schema and written into the audit event
    /// detail, but there was no column for it, so it never reached the row the UI
    /// lists: the person who asked for the deletion could not see their own stated
    /// reason, and a regulator reading the request log saw an empty one. Nullable,
    /// so existing rows are unaffected and the column is expand-only.
    reason         String?
    requestedById  String
  state          ErasureState  @default(PENDING)
  certificate    Json?
  purgeAfter     DateTime
  completedAt    DateTime?
  /// When the claim was taken, so a row stranded by a killed instance can be
  /// returned to PENDING instead of sitting in EXECUTING for ever.
  claimedAt      DateTime?
  createdAt      DateTime      @default(now())

  @@index([organizationId, state])
  @@index([state, purgeAfter])
  @@index([completedAt])
  @@map("erasure_request")
}

enum PlanTier {
