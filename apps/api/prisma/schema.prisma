/// One domain whose DMARC record this service serves from its own zone.
///
/// The customer publishes a CNAME at `_dmarc.<domain>` pointing at the token
/// name; the policy itself lives here and can change without touching their
/// DNS again.
model HostedDmarcRecord {
  id                  String             @id @default(cuid())
  organizationId      String
  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  domainId            String             @unique
  domain              Domain             @relation(fields: [domainId], references: [id], onDelete: Cascade)
  token               String             @unique
  value               String
  /// Incremented on every value change; a change must name the version it read.
  version             Int                @default(1)
  status              HostedDmarcStatus  @default(PENDING)
  providerRecordId    String?
  lastSyncedAt        DateTime?
  lastSyncError       String?
  delegated           Boolean            @default(false)
  delegationCheckedAt DateTime?
  activatedAt         DateTime?
  releaseRequestedAt  DateTime?
  releasedAt          DateTime?
  createdById         String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  changes             HostedDmarcChange[]

  @@index([organizationId])
  @@index([status])
  @@map("hosted_dmarc_record")
}

model HostedDmarcChange {
  id                String            @id @default(cuid())
  recordId          String
  record            HostedDmarcRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  organizationId    String
  previousValue     String?
  newValue          String
  /// 'created' | 'policy' | 'restore'
  reason            String
  readinessOverride Boolean            @default(false)
  actorUserId       String?
  createdAt         DateTime           @default(now())
  restoredAt        DateTime?

  @@index([recordId, createdAt])
  @@map("hosted_dmarc_change")
}

/// One domain whose SPF record this service flattens into its own zone.
///
/// The customer's apex says `v=spf1 redirect=<token>.spf.<zone>`, so our zone
/// carries the addresses and the all qualifier. `parts` is what is published;
/// `sourceState` keeps the last good networks so a provider's DNS failure never
/// removes an address that was working.
model HostedSpfRecord {
  id                  String          @id @default(cuid())
  organizationId      String
  organization        Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  domainId            String          @unique
  domain              Domain          @relation(fields: [domainId], references: [id], onDelete: Cascade)
  token               String          @unique
  status              HostedSpfStatus @default(PENDING)
  version             Int             @default(1)
  sources             Json
  allQualifier        String
  /// Last good networks and failure state per source, keyed by `${kind}:${value}`.
  sourceState         Json
  /// What is published: [{ name, content, providerRecordId }].
  parts               Json
  lookupCount         Int
  lastFlattenedAt     DateTime?
  lastFlattenError    String?
  capacityBlocked     Boolean         @default(false)
  delegated           Boolean         @default(false)
  delegationCheckedAt DateTime?
  activatedAt         DateTime?
  releaseRequestedAt  DateTime?
  releasedAt          DateTime?
  createdById         String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  changes             HostedSpfChange[]

  @@index([organizationId])
  @@index([status])
  @@map("hosted_spf_record")
}

model HostedSpfChange {
  id              String          @id @default(cuid())
  recordId        String
  record          HostedSpfRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  organizationId  String
  /// 'created' | 'sources' | 'refresh'
  reason          String
  previousSources Json?
  newSources      Json
  previousParts   Json?
  newParts        Json
  actorUserId     String?
  createdAt       DateTime        @default(now())

  @@index([recordId, createdAt])
  @@map("hosted_spf_change")
}

enum HostedBimiStatus {
  PENDING
  ACTIVE
  RELEASING
  RELEASED
}

enum HostedBimiAssetKind {
  LOGO
  CERTIFICATE
}

/// One domain whose BIMI record this service publishes from its own zone.
///
/// The customer publishes a CNAME at `default._bimi.<domain>` pointing at the
/// token name and uploads the logo (and, for Gmail and Apple Mail, the mark
/// certificate) here. The TXT we publish names the URLs of the bytes in
/// HostedBimiAsset, so replacing either is an upload rather than a DNS change.
model HostedBimiRecord {
  id                   String             @id @default(cuid())
  organizationId       String
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  domainId             String             @unique
  domain               Domain             @relation(fields: [domainId], references: [id], onDelete: Cascade)
  token                String             @unique
  status               HostedBimiStatus   @default(PENDING)
  providerRecordId     String?
  /// The TXT that was published at default._bimi before we took over, kept so
  /// the release view can hand it back.
  previousValue        String?
  lastSyncedAt         DateTime?
  lastSyncError        String?
  /// Facts from the leaf certificate, for display and for the expiry warning.
  certificateExpiresAt DateTime?
  certificateIssuer    String?
  certificateSubject   String?
  delegated            Boolean            @default(false)
  delegationCheckedAt  DateTime?
  activatedAt          DateTime?
  releaseRequestedAt   DateTime?
  releasedAt           DateTime?
  createdById          String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  assets               HostedBimiAsset[]
  changes              HostedBimiChange[]

  @@index([organizationId])
  @@index([status])
  @@map("hosted_bimi_record")
}

/// The logo or certificate bytes, in Postgres.
///
/// Not S3: LOGO_BUCKET is optional in this product and hosted BIMI must not
/// depend on it. A logo is at most 32,768 bytes and a certificate a few KB.
///
/// `retiredAt` is a grace period rather than a delete. Mailbox providers cache
/// the URLs a TXT named, so an old logo URL keeps working for a while after it
/// is replaced; a retired asset is served until the reconciler purges it after
/// seven days.
model HostedBimiAsset {
  id          String             @id @default(cuid())
  recordId    String
  record      HostedBimiRecord   @relation(fields: [recordId], references: [id], onDelete: Cascade)
  kind        HostedBimiAssetKind
  sha256      String
  bytes       Bytes
  contentType String
  createdAt   DateTime           @default(now())
  retiredAt   DateTime?

  @@unique([recordId, kind, sha256])
  @@index([recordId, kind, retiredAt])
  @@map("hosted_bimi_asset")
}

model HostedBimiChange {
  id              String           @id @default(cuid())
  recordId        String
  record          HostedBimiRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  organizationId  String
  /// 'created' | 'logo' | 'certificate' | 'certificate-removed' | 'released'
  reason          String
  previousLogoSha String?
  newLogoSha      String?
  previousCertSha String?
  newCertSha      String?
  actorUserId     String?
  createdAt       DateTime         @default(now())

  @@index([recordId, createdAt])
  @@map("hosted_bimi_change")
}

enum HostedMtaStsStatus {
  PENDING
  ACTIVE
  RELEASING
  RELEASED
}

enum HostedMtaStsMode {
  testing
  enforce
  none
}

/// One domain whose MTA-STS policy this service serves.
///
/// The customer publishes two CNAMEs once: `mta-sts.<domain>` at the shared
/// Cloudflare for SaaS target, and `_mta-sts.<domain>` at the token name. The
/// certificate is issued by Cloudflare for that custom hostname, so no
/// certificate file is ever handled here.
model HostedMtaStsRecord {
  id                  String            @id @default(cuid())
  organizationId      String
  organization        Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  domainId            String            @unique
  domain              Domain            @relation(fields: [domainId], references: [id], onDelete: Cascade)
  token               String            @unique
  status              HostedMtaStsStatus @default(PENDING)
  mode                HostedMtaStsMode   @default(testing)
  /// The policy's mx patterns: exact hostnames, or `*.` plus a hostname.
  mx                  String[]
  /// Seconds, 86400 to 31557600.
  maxAge              Int               @default(86400)
  /// The id published in `v=STSv1; id=`. Changes on every policy change.
  policyId            String
  /// Incremented on every policy change; a change must name the version it read.
  version             Int               @default(1)
  /// Cloudflare's custom hostname, and the last statuses it reported.
  customHostnameId    String?
  hostnameStatus      String?
  sslStatus           String?
  /// Cloudflare's own reason when validation failed, shown verbatim.
  sslError            String?
  txtRecordId         String?
  /// Both CNAMEs point at us.
  delegated           Boolean           @default(false)
  /// What the last check saw at each name: found | missing | elsewhere.
  mtaCnameState       String?
  txtCnameState       String?
  delegationCheckedAt DateTime?
  lastSyncedAt        DateTime?
  lastSyncError       String?
  /// The MX hosts the policy does not cover, recorded by the last scan.
  uncoveredMx         String[]          @default([])
  uncoveredCheckedAt  DateTime?
  enforcedAt          DateTime?
  releaseRequestedAt  DateTime?
  /// While set, we keep serving a `none` policy so cached policies expire.
  releaseServeUntil   DateTime?
  releasedAt          DateTime?
  /// What the customer published before we started, for a hand-back.
  previousTxt         String?
  previousPolicy      String?
  createdById         String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  changes             HostedMtaStsChange[]

  @@index([organizationId])
  @@index([status])
  @@map("hosted_mta_sts_record")
}

model HostedMtaStsChange {
  id                String             @id @default(cuid())
  recordId          String
  record            HostedMtaStsRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  organizationId    String
  /// 'created' | 'policy' | 'released'
  reason            String
  previousMode      String?
  newMode           String
  previousMx        String[]
  newMx             String[]
  previousMaxAge    Int?
  newMaxAge         Int
  previousPolicyId  String?
  newPolicyId       String
  readinessOverride Boolean            @default(false)
  actorUserId       String?
  createdAt         DateTime           @default(now())

  @@index([recordId, createdAt])
  @@map("hosted_mta_sts_change")
}

/// A signed compliance pack issued for one client.
///
/// The PDF is not stored. Its SHA-256 is, because the hash is the claim and the
/// bytes are not, and storing both would mean the document could be silently
/// replaced. History is kept so a pack an auditor already holds stays provable
/// after a later regeneration.
model CompliancePack {
  id             String    @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  scope          String
  documentVersion String
  /// The calendar month a monthly report covers, as a UTC [start, end) window.
  /// Null for compliance packs, which describe the state at `asOf`.
  periodStart    DateTime?
  periodEnd      DateTime?
  /// The state of the world the document describes, and the PDF creation date.
  /// Fixed rather than taken from the clock, so the same inputs give the same
  /// bytes and therefore the same hash.
  asOf           DateTime
  pdfHash        String    @unique
  /// The value printed in the document and quoted when asking us for the digest.
  ///
  /// Previously the document printed a freshly minted UUID that was then
  /// discarded, while the public lookup resolved against the primary key. The
  /// number a reader was told to quote therefore could not be quoted, and a
  /// regenerated-but-identical document printed a different one for the same
  /// bytes.
  ///
  /// Human-readable on purpose. A customer reading this to their compliance team
  /// needs to say it out loud, and a cuid is neither quotable nor legible.
  reference      String    @unique
  byteSize       Int
  pageCount      Int
  supersededAt   DateTime?
  generatedById  String?
  createdAt      DateTime  @default(now())
  file           ComplianceDocumentFile?
  monthlyLinks   MonthlyReportLink[]

  @@index([clientId])
  @@index([organizationId])
  @@index([createdAt])
  /// The monthly history is always read for one client, one scope and one month.
  @@index([clientId, scope, periodStart])
  @@map("compliance_pack")
}

/// The stored bytes of a monthly report.
///
/// Compliance packs keep their "not stored" design: only the hash is kept and
/// the PDF is streamed once. A monthly report is different because the client
/// downloads it later from the portal, and an emailed link has to keep working
/// after the agency closed the tab.
model ComplianceDocumentFile {
  id          String         @id @default(cuid())
  packId      String         @unique
  pack        CompliancePack @relation(fields: [packId], references: [id], onDelete: Cascade)
  bytes       Bytes
  contentType String
  /// The aggregate retention window, measured from the end of the reported month.
  /// Never printed or shown; the UI says the report is available while the data
  /// it summarises is held.
  expiresAt   DateTime
  createdAt   DateTime       @default(now())

  @@index([expiresAt])
  @@map("compliance_document_file")
}

/// One monthly-issue schedule per client.
model MonthlyReportSchedule {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId          String       @unique
  client            Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  enabled           Boolean      @default(true)
  dayOfMonth        Int          @default(2)
  sendHourUtc       Int          @default(9)
  recipientEmails   String[]
  /// YYYY-MM of the last period this schedule issued. The claim that makes two
  /// instances issue once is a conditional update keyed on the value read.
  lastIssuedPeriod  String?
  createdById       String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([enabled])
  @@map("monthly_report_schedule")
}

/// A bearer link emailed to one recipient for one monthly report.
///
/// Only the SHA-256 of the token is stored. The raw token exists in the email
/// and nowhere else, so a database read cannot produce a working link.
model MonthlyReportLink {
  id             String         @id @default(cuid())
  packId         String
  pack           CompliancePack @relation(fields: [packId], references: [id], onDelete: Cascade)
  tokenHash      String         @unique
  recipientEmail String
  expiresAt      DateTime
  lastUsedAt     DateTime?
  useCount       Int            @default(0)
  createdAt      DateTime       @default(now())

  @@index([packId])
  @@index([expiresAt])
  @@map("monthly_report_link")
}

/// A billing webhook that has been received, with the provider's own id
/// deduplicating redeliveries. Both providers retry until acknowledged, so the
/// same event can arrive many times and out of order.
model BillingEvent {
  id                     String        @id @default(cuid())
  providerEventId        String        @unique
  provider               BillingProvider
  type                   String
  organizationId         String?
  organization           Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  providerSubscriptionId String?
  /// The provider's own webhook body, verbatim.
  ///
  /// Nullable because it is erased, not because it is optional. A Razorpay or
  /// Paddle subscription payload carries the customer's name and email, so it is
  /// personal data with no declared retention behind it. The row is kept because
  /// `providerEventId` is what makes webhook processing idempotent and
  /// `occurredAt` is what orders events; the provider keeps its own copy, and
  /// everything this service actually reasons about is in the typed columns
  /// beside it.
  payload                Json?
  occurredAt             DateTime
  createdAt              DateTime      @default(now())

  @@index([organizationId])
  @@index([providerSubscriptionId])
  @@index([createdAt])
  @@map("billing_event")
}

model RateLimitBucket {
  /// The key `express-rate-limit` generated for this client, e.g. an IP address or
  /// an API key fingerprint.
  key       String
  /// The limiter that owns the bucket.
  ///
  /// Part of the primary key, not a plain column, because the limiters enforce
  /// different budgets for different reasons. Sharing one namespace would let an
  /// API key that has spent its report quota also spend the login limiter's budget.
  limiter   String
  hits      Int       @default(0)
  /// When the current window closes and the count becomes meaningless.
  ///
  /// Doubles as the sweep predicate, which is why the sweeper can delete expired
  /// buckets without tracking a separate expiry column. No database default: the
  /// window is always derived from the request that opened the bucket, so a
  /// defaulted value would only ever be wrong.
  resetAt   DateTime
  createdAt DateTime  @default(now())

  /// Read and written exclusively through raw SQL.
  ///
  /// The increment is a single `INSERT ... ON CONFLICT DO UPDATE SET hits =
  /// "hits" + 1 RETURNING hits`, because read-modify-write is not atomic and a
  /// limiter that loses a race is a limiter that undercounts. Prisma has no
  /// upsert-and-return expression, so the model is declared here for schema
  /// parity while the queries stay in the store.
  ///
  /// Declared rather than omitted deliberately: a table that exists in the
  /// migrations but not in this file reads as drift to `prisma migrate diff` and
  /// gets dropped by the next `prisma migrate dev` on someone's machine.
  @@id([key, limiter])
  @@index([resetAt])
  @@map("rate_limit_bucket")
}

model IdempotencyRecord {
  id             String       @id @default(cuid())
  key            String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestHash    String
  statusCode     Int?
  responseBody   Json?
  createdAt      DateTime     @default(now())

  /// Scoped to the workspace, deliberately.
  ///
  /// This used to be unique on `key` alone, which made every customer's
  /// idempotency namespace the same namespace. One workspace choosing a key
  /// another workspace already held then overwrote that workspace's stored
  /// response, because the upsert's update branch did not rewrite
  /// `organizationId`: the reader still saw the original owner and happily
  /// replayed the second workspace's payload to them, including its client ids
  /// and DNS verification values. The key is chosen by the caller, so it has to
  /// be unique per caller rather than globally.
  @@unique([organizationId, key])
  @@index([createdAt])
  @@index([organizationId])
  @@map("idempotency_record")
}

model ExportJob {
  id                 String        @id @default(cuid())
  organizationId     String
  organization       Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedById      String
  scope              ExportScope   @default(ORGANIZATION)
  targetId           String?
  scopeLabel         String
  format             ExportFormat  @default(JSON)
  state              ExportState   @default(READY)
  downloadTokenHash  String?       @unique
  downloadExpiresAt  DateTime?
  downloadedAt       DateTime?
  redactions         Json?
  purgeAfter         DateTime
  createdAt          DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([state, purgeAfter])
  @@map("export_job")
}

