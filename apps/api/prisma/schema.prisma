  MANAGED_SPF_RELEASE_REQUESTED
  MANAGED_SPF_RELEASED
  HOSTED_BIMI_CREATED
  HOSTED_BIMI_LOGO_UPDATED
  HOSTED_BIMI_CERTIFICATE_UPDATED
  HOSTED_BIMI_CERTIFICATE_REMOVED
  HOSTED_BIMI_RELEASED
  HOSTED_MTA_STS_CREATED
  HOSTED_MTA_STS_UPDATED
  HOSTED_MTA_STS_RELEASE_REQUESTED
  HOSTED_MTA_STS_RELEASED
}

enum AuditOutcome {
  SUCCESS
  DENIED
}

enum AlertDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED_QUIET_HOURS
  SKIPPED_DISABLED
}

enum EmailDeliveryState {
  PENDING
  SENT
  /// Retries are exhausted. Kept rather than deleted, because a message that silently
  /// vanished is the failure mode this table exists to remove, and a dead letter row
  /// is at least something an operator can see and resend.
  DEAD
}

/// Public network facts for a sending IP. Not tenant data: the same address
/// describes the same infrastructure for every workspace.
enum IpIntelStatus {
  OK
  PARTIAL
  FAILED
  PRIVATE
}

model SourceIpIntel {
  ip           String        @id
  ptr          String?
  ptrConfirmed Boolean       @default(false)
  asn          Int?
  asnName      String?       @db.VarChar(120)
  status       IpIntelStatus
  lookedUpAt   DateTime
  expiresAt    DateTime
  lastSeenAt   DateTime

  @@index([expiresAt])
  @@index([lastSeenAt])
  @@map("source_ip_intel")
}

enum SenderReviewStatus {
  APPROVED
  NOT_OURS
}

/// A person's decision about one sender in one domain. No row means unreviewed.
model SenderReview {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  domainId       String
  domain         Domain              @relation(fields: [domainId], references: [id], onDelete: Cascade)
  senderKey      String
  /// Null while the row carries only an owner. The pair is unique, so the
  /// owner can be kept when the review is cleared back to unreviewed.
  status         SenderReviewStatus?
  ownerUserId    String?
  ownerUser      User?               @relation("SenderReviewOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  note           String?             @db.VarChar(280)
  reviewedById   String?
  reviewedBy     User?               @relation("SenderReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([domainId, senderKey])
  @@index([organizationId])
  @@map("sender_review")
}

model EmailDelivery {
  id             String            @id @default(cuid())
  /// Where it was sent from, so a dead letter says which subsystem lost it.
  kind           String
  to             String
  subject        String
  html           String
  text           String
  state          EmailDeliveryState @default(PENDING)
  attempts       Int                @default(0)
  /// Exponential backoff, so a provider outage does not turn into a retry storm.
  nextAttemptAt  DateTime           @default(now())
  lastError      String?
  lastAttemptAt  DateTime?
  sentAt         DateTime?
  /// Collapses duplicate sends of the same logical message, so a retried request
  /// cannot turn into two password reset links arriving minutes apart.
  idempotencyKey String?            @unique
  organizationId String?
  createdAt      DateTime           @default(now())

  @@index([state, nextAttemptAt])
  @@index([state, createdAt])
  @@map("email_delivery")
}
