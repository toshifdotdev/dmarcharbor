# The web app's environment. Every value is read server-side only, except
# NEXT_PUBLIC_APP_HOST, which Next inlines into the build.
#
#   API_BASE_URL  the DMARC Harbor API this console talks to, WITH its /api
#                 suffix, e.g. http://localhost:4000.
#
# It is read in two places and both are server-side:
#   next.config.ts  the rewrite that proxies /api/* to the API (module scope,
#                   so the target is fixed at build time)
#   lib/api.ts, lib/api-ops.ts, lib/api-writes.ts  direct server fetches
#
# A production build FAILS if it is unset (see the assertion in
# next.config.ts): a build that succeeds and then 500s at runtime for the user
# is worse than a build that stops.
API_BASE_URL=http://localhost:4000

# SITE_URL  the one public origin, read at runtime (lib/site-origin.ts). Every
# canonical URL, og:url, sitemap entry, robots.txt sitemap line, security.txt
# and JSON-LD id is built on it, and only its hostname is indexable: www.,
# app., a raw IP or any other host serving the same pages says noindex.
# REQUIRED in production: SITE_URL=https://dmarcharbor.com
# An origin only: https, no www., no trailing path. The server refuses to start
# on a value without its scheme, an http one in production, or one with a path
# (instrumentation.ts, lib/site-config.ts). Requests on www.dmarcharbor.com are
# sent here with a permanent redirect (proxy.ts).
# Leave unset in development and the verify harness: each host is then its own
# canonical, and only the app-local hosts below count as ours.
# SITE_URL=https://dmarcharbor.com

# NEXT_PUBLIC_APP_HOST  the hostname the app answers on, no scheme or port
# (proxy.ts). Requests on it skip the custom-domain branding lookup. Inlined at
# build time, so it must be set before `next build`; the build refuses one with
# a scheme, port or path. Same host as SITE_URL.
# REQUIRED in production, e.g. NEXT_PUBLIC_APP_HOST=dmarcharbor.com
# NEXT_PUBLIC_APP_HOST=dmarcharbor.com

# Search-console ownership tags (optional). Rendered on our own host only.
# The token is the tag's content value; a whole pasted tag is reduced to it.
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=

# DEV_ALLOWED_ORIGINS  hostnames the Next dev server will serve for, comma
# separated and without ports. Needed for white-label testing: a custom domain has to
# reach the dev server for branding to resolve, and Next refuses an unlisted one.
# DEV_ALLOWED_ORIGINS=portal.example.com,branding.example.com
