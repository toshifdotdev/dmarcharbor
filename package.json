{
  "name": "dmarcharbor",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "workers/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace @dmarcharbor/api\" \"npm run dev --workspace @dmarcharbor/web\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "test": "npm run test --workspace @dmarcharbor/api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.1.2",
    "eslint": "^10.11.0",
    "typescript-eslint": "^8.70.1"
  }
}
